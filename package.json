{
  "name": "repotted-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "audit": "pnpm audit --audit-level low",
    "build": "pnpm --filter repotted run build",
    "directives:check": "node scripts/check-directives.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "lint": "pnpm run directives:check && oxlint .",
    "lint:fix": "pnpm run directives:check && oxlint --fix .",
    "standards": "pnpm run lint:fix && pnpm run format",
    "test": "vitest run",
    "typecheck": "tsc --pretty -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint-plugin-regexp": "3.3.1",
    "knip": "6.43.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.1.0"
  }
}
