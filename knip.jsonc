{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"],
    },
    "packages/core": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
    },
    "packages/cli": {
      "entry": ["src/main.ts", "build.ts", "sea.ts", "tests/**/*.test.ts", "tests/*.mjs"],
      "project": ["src/**/*.ts", "tests/**/*.{ts,mjs}"],
      // The build bundles @repotted/core and leaves this to npm, so the
      // published package needs it although no file in cli imports it.
      "ignoreDependencies": ["@octokit/core"],
    },
  },
}
