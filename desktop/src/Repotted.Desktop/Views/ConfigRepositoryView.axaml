<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="using:Repotted.Desktop.Theme"
             xmlns:vm="using:Repotted.Desktop.ViewModels"
             x:Class="Repotted.Desktop.Views.ConfigRepositoryView"
             x:DataType="vm:ConfigRepositoryViewModel">
  <ScrollViewer>
    <StackPanel Margin="32,24" Spacing="20" MaxWidth="560" HorizontalAlignment="Left">
      <StackPanel Spacing="6">
        <TextBlock Classes="h1" Text="{theme:Label 'Keep profiles on GitHub'}" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Profiles live in a repository, so they follow you to any computer and keep their history. Each save is a commit to the repository's default branch, and a refresh brings in changes made elsewhere." />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Classes="small" FontWeight="SemiBold" Text="Repository" />
        <AutoCompleteBox x:Name="RepositoryBox" Text="{Binding Repository}" ItemsSource="{Binding Repositories}"
                         FilterMode="ContainsOrdinal" MinimumPrefixLength="0" PlaceholderText="owner/name, such as you/repotted-config"
                         AutomationProperties.Name="Repository" />
        <TextBlock Classes="muted small" TextWrapping="Wrap"
                   Text="Any repository the Repotted App is installed on, with the Contents permission. An empty one starts with the profiles saved here." />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Classes="small" FontWeight="SemiBold" Text="Folder in the repository" />
        <TextBox Text="{Binding Path}" PlaceholderText="The repository's root" AutomationProperties.Name="Folder in the repository" />
        <TextBlock Classes="muted small" TextWrapping="Wrap"
                   Text="Only YAML files sync, from this folder and the folders in it. Hidden folders such as .github stay out." />
      </StackPanel>

      <CheckBox IsChecked="{Binding CopyLocal}" IsVisible="{Binding CanCopyLocal}">
        <TextBlock TextWrapping="Wrap" Text="{Binding CopyLocalLabel}" />
      </CheckBox>

      <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource RemoveBrush}"
                           IsVisible="{Binding HasError}" AutomationProperties.LiveSetting="Assertive" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="primary" Content="Use this repository" Command="{Binding ConnectCommand}" IsDefault="True" />
        <Button Classes="quiet" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
        <TextBlock Classes="muted small" VerticalAlignment="Center" Text="Syncing with GitHub" IsVisible="{Binding Working}"
                   AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
