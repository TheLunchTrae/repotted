<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="using:Repotted.Desktop.Theme"
             xmlns:vm="using:Repotted.Desktop.ViewModels"
             x:Class="Repotted.Desktop.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">
  <UserControl.Resources>
    <!--
      One setting: where its value comes from, its choices or a box to type it
      in, a way back, and any draft of it. A sub-option sits indented under its setting, and a
      note says what the setting can't do here. Choices too long to sit beside
      the label go under it. A setting that another one turns off, such as a
      runner label with standard runners, keeps its value but can't be edited,
      and says why. A tab leaves out a setting that another one hides, as
      Actions off hides which actions are allowed, and search shows it off.
      The setting that hides others says when the profile still names them.
    -->
    <DataTemplate x:Key="SettingRow" x:DataType="vm:SettingViewModel">
      <Border Classes="field" Classes.nested="{Binding Nested}" Classes.off="{Binding !Enabled}">
        <Grid ColumnDefinitions="4,*,Auto,150" RowDefinitions="Auto,Auto,Auto">
          <Border Grid.RowSpan="3" Classes="rail" Classes.own="{Binding OwnAfterSave}" Classes.inherited="{Binding InheritedAfterSave}"
                  Classes.changed="{Binding Changed}" />
          <StackPanel Grid.Column="1" Classes="setting" Classes.nested="{Binding Nested}" VerticalAlignment="Center" Spacing="2">
            <TextBlock Classes="dims" Text="{Binding Label}" FontWeight="SemiBold" FontSize="14.5" TextWrapping="Wrap" />
            <TextBlock Classes="mono muted dims" FontSize="12.5" Text="{Binding Key}" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Key}" />
            <TextBlock Classes="muted small" Text="{Binding FieldNote}" IsVisible="{Binding HasFieldNote}"
                       TextWrapping="Wrap" Margin="0,2,0,0" />
            <TextBlock Classes="muted small" Text="{Binding WhyOff}" IsVisible="{Binding !Enabled}"
                       TextWrapping="Wrap" Margin="0,2,0,0" />
            <TextBlock Classes="small" Text="{Binding HiddenNote}" IsVisible="{Binding HasHiddenNote}"
                       TextWrapping="Wrap" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel Grid.Row="{Binding OptionsRow}" Grid.Column="{Binding OptionsColumn}" Grid.ColumnSpan="{Binding OptionsSpan}"
                      Classes="typed" Classes.wide="{Binding Wide}" Classes.nested="{Binding Nested}"
                      VerticalAlignment="Center" Spacing="4" IsVisible="{Binding IsTyped}">
            <TextBox Classes="setting" Text="{Binding Typed}" Classes.number="{Binding IsNumber}" IsEnabled="{Binding Enabled}"
                     Classes.list="{Binding IsList}" AcceptsReturn="{Binding IsList}"
                     AutomationProperties.Name="{Binding TypedName}"
                     AutomationProperties.HelpText="{Binding TypedHelp}" />
            <TextBlock Classes="problem small" Text="{Binding TypedProblem}" IsVisible="{Binding HasTypedProblem}"
                       TextWrapping="Wrap" MaxWidth="240" />
          </StackPanel>
          <Border Grid.Row="{Binding OptionsRow}" Grid.Column="{Binding OptionsColumn}" Grid.ColumnSpan="{Binding OptionsSpan}"
                  Classes="seg" Classes.wide="{Binding Wide}" Classes.nested="{Binding Nested}" IsVisible="{Binding IsChoice}"
                  IsEnabled="{Binding Enabled}">
            <ItemsControl ItemsSource="{Binding Options}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OptionViewModel">
                  <!-- A toggle, so screen readers hear which option is chosen. -->
                  <ToggleButton Classes="seg" Classes.on="{Binding Selected}" Classes.dim="{Binding Dim}"
                                IsChecked="{Binding Selected, Mode=OneWay}"
                                Content="{Binding Label}" Command="{Binding ChooseCommand}"
                                AutomationProperties.Name="{Binding AccessibleName}"
                                AutomationProperties.HelpText="{Binding Help}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <StackPanel Grid.Column="3" Margin="16,0" VerticalAlignment="Center" Spacing="2">
            <TextBlock Classes="muted small" Text="{Binding Note}" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Classes="link" FontSize="13" HorizontalAlignment="Left" Content="{Binding ResetLabel}"
                      IsVisible="{Binding CanReset}" Command="{Binding ResetCommand}"
                      AutomationProperties.Name="{Binding ResetName}" />
              <Button Classes="link" FontSize="13" HorizontalAlignment="Left" Content="Save as draft"
                      IsVisible="{Binding CanSaveAsDraft}" Command="{Binding SaveAsDraftCommand}"
                      AutomationProperties.Name="{Binding Label, StringFormat='Save the change to {0} as a draft'}"
                      AutomationProperties.HelpText="Keeps the value in the profile without applying it, and puts the setting back as it was." />
            </StackPanel>
          </StackPanel>
          <!-- The draft: saved with the profile, left out of compare and apply until it is finished. -->
          <Grid Grid.Row="2" Grid.ColumnSpan="4" ColumnDefinitions="4,Auto,*,Auto" IsVisible="{Binding HasDraft}" Margin="0,0,0,10">
            <Border Grid.Column="1" Classes="pill none" Margin="16,0,10,0">
              <StackPanel Orientation="Horizontal"><Ellipse /><TextBlock Text="Draft" /></StackPanel>
            </Border>
            <TextBlock Grid.Column="2" Classes="small" VerticalAlignment="Center" TextWrapping="Wrap"
                       AutomationProperties.Name="{Binding DraftName}">
              <Run Text="{Binding DraftLabel}" FontWeight="SemiBold" />
              <Run Text="{Binding DraftNote, StringFormat=' · {0}'}" Foreground="{DynamicResource MutedBrush}" />
            </TextBlock>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" Margin="16,0" IsVisible="{Binding OwnDraft}">
              <Button Classes="link" FontSize="13" Content="Finish draft" Command="{Binding FinishDraftCommand}"
                      AutomationProperties.Name="{Binding Label, StringFormat='Finish the draft of {0}'}"
                      AutomationProperties.HelpText="Makes the draft the value, so it applies once the profile is saved." />
              <Button Classes="link" FontSize="13" Content="Discard draft" Command="{Binding DiscardDraftCommand}"
                      AutomationProperties.Name="{Binding Label, StringFormat='Discard the draft of {0}'}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- One choice of an entry: its options, and a way to leave it to GitHub. -->
    <DataTemplate x:Key="ChoiceRow" x:DataType="vm:ChoiceViewModel">
      <Border Classes="field" MinHeight="56">
        <Grid ColumnDefinitions="180,*" Margin="16,10">
          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="4">
            <Border Classes="seg">
              <ItemsControl ItemsSource="{Binding Options}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChoiceOptionViewModel">
                    <ToggleButton Classes="seg" Classes.on="{Binding Shown}" Classes.dim="{Binding Dim}"
                                  IsChecked="{Binding Selected, Mode=OneWay}"
                                  Content="{Binding Label}" Command="{Binding ChooseCommand}"
                                  AutomationProperties.Name="{Binding AccessibleName}"
                                  AutomationProperties.HelpText="{Binding Note}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <TextBlock Classes="muted small" Text="{Binding Note}" TextWrapping="Wrap" IsVisible="{Binding !IsSet}" />
            <Button Classes="link" FontSize="13" HorizontalAlignment="Left" Content="Leave it to GitHub"
                    IsVisible="{Binding IsSet}" Command="{Binding ClearCommand}"
                    AutomationProperties.Name="{Binding Label, StringFormat='Leave {0} to GitHub'}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- A rule parameter that is on or off; dimmed until the profile sets it. -->
    <DataTemplate x:Key="FlagRow" x:DataType="vm:FlagViewModel">
      <CheckBox Classes.dim="{Binding Dim}" IsChecked="{Binding Value}" Content="{Binding Label}"
                AutomationProperties.HelpText="{Binding HelpText}" />
    </DataTemplate>

    <!-- The name, and whether the profile manages the entry or removes it from GitHub. -->
    <DataTemplate x:Key="EntryHead" x:DataType="vm:EntryEditorViewModel">
      <Border Classes="fields">
        <StackPanel Margin="0,-1,0,0">
          <Border Classes="field" MinHeight="56">
            <Grid ColumnDefinitions="180,*" Margin="16,10">
              <TextBlock Text="Name" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBox Classes="entryName" Text="{Binding Name}" IsReadOnly="{Binding !Renamable}" MaxWidth="420"
                         HorizontalAlignment="Left" MinWidth="320" AttachedToVisualTree="OnEntryNameAttached"
                         AutomationProperties.Name="{Binding NameLabel}" />
                <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding !Renamable}"
                           Text="A base profile names this one, so this profile keeps its name and sets the rest." />
                <TextBlock Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource RemoveBrush}" Text="{Binding RenameNote}"
                           IsVisible="{Binding RenameNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                           AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </Grid>
          </Border>
          <!-- A label's old names, which apply renames so issues keep the label. Other entries have none. -->
          <ContentControl Content="{Binding}">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="vm:LabelEditorViewModel">
                <Border Classes="field" IsVisible="{Binding Manages}">
                  <Grid ColumnDefinitions="180,*" Margin="16,10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Renamed from" FontWeight="SemiBold" FontSize="14" />
                      <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="0,0,12,0" Text="One old name per line." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBox AcceptsReturn="True" MinHeight="64" MaxWidth="420" MinWidth="320" HorizontalAlignment="Left"
                               Text="{Binding RenamedFrom}" AutomationProperties.Name="Old names"
                               AutomationProperties.HelpText="A repository that has one of these and not this label has it renamed." />
                      <TextBlock Classes="muted small" TextWrapping="Wrap"
                                 Text="A repository that has one of these and not this label has it renamed, so issues and pull requests keep the label. Where both are there, apply leaves both and says so." />
                      <Button Classes="link" HorizontalAlignment="Left" IsVisible="{Binding CanAddOldName}"
                              Content="{Binding Source='Rename it on GitHub too', Converter={x:Static theme:ControlLabel.Converter}}"
                              Command="{Binding AddOldNameCommand}" AutomationProperties.HelpText="{Binding AddOldNameHelp}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
              <DataTemplate DataType="vm:EntryEditorViewModel">
                <Panel />
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
          <Border Classes="field" MinHeight="56" IsVisible="{Binding Drafts}">
            <Grid ColumnDefinitions="180,*" Margin="16,10">
              <TextBlock Text="Draft" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="4">
                <CheckBox IsChecked="{Binding IsDraft}" Content="Save as a draft" IsEnabled="{Binding CanDraft}"
                          AutomationProperties.HelpText="{Binding DraftNote}" />
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding DraftNote}" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Classes="field" MinHeight="56">
            <Grid ColumnDefinitions="180,*" Margin="16,10">
              <TextBlock Text="On GitHub" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20">
                <RadioButton GroupName="{Binding Kind}" IsChecked="{Binding Manages}" Content="Manage it" />
                <RadioButton GroupName="{Binding Kind}" IsChecked="{Binding Removes}"
                             Content="Remove it from the repository" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>
    <!-- Back to the profiles, with none open; unsaved changes ask first -->
    <Button x:Name="CloseButton" DockPanel.Dock="Top" Classes="link" Margin="32,16,32,0" HorizontalAlignment="Left"
            Content="Close profile" IsVisible="{Binding CanClose}" Command="{Binding CloseCommand}" />
    <!-- Heading and actions -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="32,24,32,0">
      <StackPanel Spacing="6">
        <TextBlock Classes="h1" Text="{Binding Name}" />
        <TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" ToolTip.Tip="{Binding File}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <TextBlock Classes="muted small" VerticalAlignment="Center" Text="{Binding ChangesLabel}"
                   IsVisible="{Binding HasChanges}" />
        <Button Classes="quiet" Content="Discard" IsVisible="{Binding HasChanges}" Command="{Binding DiscardCommand}" />
        <Button Classes="quiet" Content="{Binding YamlLabel}" Command="{Binding ToggleYamlCommand}" />
        <Button Classes="primary" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" />
      </StackPanel>
    </Grid>

    <!-- The file is gone, and only the unsaved edits keep the profile -->
    <TextBlock DockPanel.Dock="Top" Margin="32,12,32,0" Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource DriftBrush}"
               Text="{Binding RemovedMessage}" IsVisible="{Binding Removed}" AutomationProperties.LiveSetting="Assertive" />
    <!-- The file changed since the editor read it, so a save waits for a side -->
    <Grid DockPanel.Dock="Top" Margin="32,12,32,0" ColumnDefinitions="*,Auto" IsVisible="{Binding OutOfDate}">
      <TextBlock Classes="small" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource DriftBrush}"
                 Text="{Binding OutOfDateMessage}" AutomationProperties.LiveSetting="Assertive" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
        <Button Classes="quiet" Content="Keep mine" Command="{Binding KeepMineCommand}" />
        <Button Classes="quiet" Content="Reload" Command="{Binding ReloadCommand}" IsVisible="{Binding !Removed}" />
      </StackPanel>
    </Grid>
    <SelectableTextBlock DockPanel.Dock="Top" Margin="32,12,32,0" TextWrapping="Wrap" Text="{Binding SaveError}"
                         Foreground="{DynamicResource RemoveBrush}" IsVisible="{Binding HasSaveError}" />
    <TextBlock DockPanel.Dock="Top" Margin="32,12,32,0" TextWrapping="Wrap" Classes="small"
               Text="{Binding Problem, StringFormat='Fix this before saving: {0}'}"
               Foreground="{DynamicResource RemoveBrush}" IsVisible="{Binding HasProblem}"
               AutomationProperties.LiveSetting="Assertive" />
    <!-- What each draft still needs before it can be finished; drafts may be saved unfinished -->
    <StackPanel DockPanel.Dock="Top" Margin="32,12,32,0" Spacing="2" IsVisible="{Binding HasDraftWarnings}">
      <TextBlock Classes="small muted" Text="What the drafts still need" />
      <ItemsControl ItemsSource="{Binding DraftWarnings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="small muted" TextWrapping="Wrap" Text="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Panel>
      <TextBlock Classes="muted" Margin="32,24" Text="Loading the profile" IsVisible="{Binding Loading}" />

      <StackPanel Margin="32,24" Spacing="12" IsVisible="{Binding HasError}">
        <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource RemoveBrush}" />
        <Button Classes="quiet" Content="Try again" HorizontalAlignment="Left" Command="{Binding LoadCommand}" />
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto" Margin="32,16,32,24" IsVisible="{Binding ShowEditor}"
            IsEnabled="{Binding !Saving}">
        <DockPanel>
          <!--
            The settings search and filters. While either is on, what they
            found on every settings tab shows in place of the tabs.
          -->
          <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox x:Name="SettingsSearch" Classes="search" Width="300" Margin="0,0,12,0" VerticalAlignment="Center"
                     PlaceholderText="Search settings" Text="{Binding Query}"
                     AutomationProperties.Name="Search settings"
                     AutomationProperties.HelpText="Finds settings by name, description, or API field name, on every settings tab.">
              <TextBox.InnerRightContent>
                <Border Classes="kbd" Margin="6,0,0,0" IsHitTestVisible="False">
                  <TextBlock x:Name="SearchShortcut" Classes="mono muted" FontSize="12" Text="Ctrl F" />
                </Border>
              </TextBox.InnerRightContent>
            </TextBox>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <ToggleButton Classes="chip" Content="Managed" IsChecked="{Binding OnlyManaged}"
                            AutomationProperties.HelpText="Shows only settings this profile or a profile it extends sets." />
              <ToggleButton Classes="chip" Content="Not saved yet" IsChecked="{Binding OnlyUnsaved}"
                            AutomationProperties.HelpText="Shows only settings with a change waiting to be saved." />
              <ToggleButton Classes="chip" Content="Drafts" IsChecked="{Binding OnlyDrafts}" IsVisible="{Binding HoldsDrafts}"
                            AutomationProperties.HelpText="Shows only settings with a draft, saved in this profile or a profile it extends." />
              <Button Classes="link" Margin="4,0,0,0" Content="Clear" IsVisible="{Binding Filtering}"
                      Command="{Binding ClearFiltersCommand}" AutomationProperties.Name="Clear the search and filters" />
            </StackPanel>
          </WrapPanel>

          <!--
            Tabs, each with how many values the profile manages there. They
            wrap onto a second line when the YAML leaves too little room.
          -->
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                  IsVisible="{Binding !Filtering}">
            <ListBox Classes="tabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                     AutomationProperties.Name="Sections" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.Styles>
                <Style Selector="ListBoxItem" x:DataType="vm:ProfileTabViewModel">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileTabViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name, Converter={x:Static theme:ControlLabel.Converter}}" VerticalAlignment="Center" />
                    <Border Classes="count"><TextBlock Text="{Binding Count}" /></Border>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <!-- What the search and filters found, in place of the tabs -->
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                  Padding="0,0,0,10" IsVisible="{Binding Filtering}">
            <TextBlock Classes="muted" Text="{Binding ResultsSummary}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
          </Border>

          <!-- What the rails mean -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="20" Margin="0,14,0,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="legend" Background="{DynamicResource RailBrush}" />
              <TextBlock Classes="muted small" Text="{Binding OwnLabel}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="legend" Background="{DynamicResource RailInheritedBrush}" />
              <TextBlock Classes="muted small" Text="{Binding InheritedLabel}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="legend" Background="{DynamicResource DriftRailBrush}" />
              <TextBlock Classes="muted small" Text="Not saved yet" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="legend" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
              <TextBlock Classes="muted small" Text="Not managed" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>

          <ScrollViewer x:Name="Scroller">
            <Panel>
              <ItemsControl ItemsSource="{Binding Results}" Margin="0,8,16,0" IsVisible="{Binding Filtering}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingResultsViewModel">
                    <StackPanel Margin="0,12,0,8" Spacing="4" IsVisible="{Binding Shown}">
                      <TextBlock Classes="muted small" Text="{Binding Tab}" />
                      <TextBlock Classes="h2" Text="{Binding Title}" Margin="0,0,0,8" />
                      <Border Classes="fields">
                        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,-1,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingResultViewModel">
                              <ContentControl Content="{Binding Setting}" ContentTemplate="{StaticResource SettingRow}"
                                              IsVisible="{Binding Shown}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ContentControl Content="{Binding SelectedTab}" Margin="0,8,16,0" IsVisible="{Binding !Filtering}">
                <ContentControl.DataTemplates>
                  <DataTemplate DataType="vm:ProfileTabViewModel">
                    <Panel>
                      <!-- A section's settings, in groups -->
                      <ItemsControl ItemsSource="{Binding Groups}" IsVisible="{Binding IsSettings}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SettingGroupViewModel">
                            <StackPanel Margin="0,12,0,8" Spacing="4">
                              <TextBlock Classes="h2" Text="{Binding Title}" />
                              <TextBlock Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap"
                                         Margin="0,0,0,8" />
                              <Border Classes="fields">
                                <ItemsControl ItemsSource="{Binding Settings}" Margin="0,-1,0,0">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SettingViewModel">
                                      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SettingRow}"
                                                      IsVisible="{Binding !Hidden}" />
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </Border>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- The rulesets, environments or labels the profile names -->
                      <StackPanel Spacing="10" Margin="0,12,0,0" IsVisible="{Binding IsEntries}">
                        <StackPanel Spacing="10" IsVisible="{Binding ShowList}" PropertyChanged="OnListPropertyChanged">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Help}" />
                            <Button Grid.Column="1" Classes="quiet" Margin="16,0,0,0" Content="{Binding NewLabel}"
                                    Command="{Binding NewCommand}" />
                          </Grid>
                          <TextBlock Classes="muted" Text="The profile names none." IsVisible="{Binding !HasEntries}" />
                          <Border Classes="fields" IsVisible="{Binding HasEntries}">
                            <ItemsControl ItemsSource="{Binding Entries}" Margin="0,-1,0,0">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EntryViewModel">
                                  <Border Classes="field" MinHeight="48">
                                    <Button Classes="entry" Command="{Binding OpenCommand}"
                                            AutomationProperties.Name="{Binding AccessibleName}">
                                      <Grid ColumnDefinitions="4,Auto,*,Auto,Auto">
                                        <Border Classes="rail" Classes.own="{Binding Own}" Classes.inherited="{Binding !Own}"
                                                Classes.changed="{Binding Changed}" />
                                        <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   FontSize="14.5" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="360"
                                                   Classes.gone="{Binding Dropped}" IsVisible="{Binding !IsLabel}" />
                                        <!-- A label shows as GitHub shows it: its name on its color. -->
                                        <Panel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsLabel}">
                                          <Border Classes="chip" Background="{Binding Hex, Converter={x:Static theme:LabelChip.Brush}}"
                                                  IsVisible="{Binding HasColor}">
                                            <TextBlock Text="{Binding Name}" Foreground="{Binding Ink, Converter={x:Static theme:LabelChip.Brush}}"
                                                       Classes.struck="{Binding Absent}" Classes.gone="{Binding Dropped}" />
                                          </Border>
                                          <Border Classes="chip plain" IsVisible="{Binding !HasColor}">
                                            <TextBlock Text="{Binding Name}" Classes.struck="{Binding Absent}" Classes.gone="{Binding Dropped}" />
                                          </Border>
                                        </Panel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,16,0" Spacing="10" VerticalAlignment="Center">
                                          <Border Classes="pill none" IsVisible="{Binding IsDraft}">
                                            <StackPanel Orientation="Horizontal"><Ellipse /><TextBlock Text="Draft" /></StackPanel>
                                          </Border>
                                          <TextBlock Classes="muted small" VerticalAlignment="Center" Text="{Binding Description}"
                                                     TextTrimming="CharacterEllipsis" MaxWidth="320"
                                                     IsVisible="{Binding IsLabel}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Margin="16,0" Classes="muted small" VerticalAlignment="Center"
                                                   Text="{Binding Note}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                        <TextBlock Grid.Column="4" Margin="0,0,16,0" Classes="muted" VerticalAlignment="Center"
                                                   Text="&#x203A;" FontSize="18" />
                                      </Grid>
                                    </Button>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Border>
                        </StackPanel>

                        <!-- One entry, open in its editor -->
                        <StackPanel Spacing="12" IsVisible="{Binding !ShowList}">
                          <Button Classes="link" HorizontalAlignment="Left" Content="{Binding BackLabel}"
                                  Command="{Binding BackCommand}" />
                          <ContentControl Content="{Binding Editing}">
                            <ContentControl.DataTemplates>
                              <DataTemplate DataType="vm:EntryViewModel">
                                <StackPanel Spacing="12">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                      <TextBlock Classes="h2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                      <TextBlock Classes="muted small" Text="{Binding Note}" TextWrapping="Wrap"
                                                 AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                      <Button Classes="quiet" Content="{Binding DropLabel}"
                                              IsVisible="{Binding CanDrop}" Command="{Binding DropCommand}"
                                              AutomationProperties.HelpText="Takes it out of this profile, once the profile is saved." />
                                      <Button Classes="quiet" Content="Put it back" IsVisible="{Binding Dropped}"
                                              Command="{Binding PutBackCommand}"
                                              AutomationProperties.HelpText="Keeps it in this profile, as it is saved." />
                                    </StackPanel>
                                  </Grid>
                                  <ContentControl Content="{Binding Editor}" IsEnabled="{Binding Editable}" />
                                </StackPanel>
                              </DataTemplate>
                              <DataTemplate DataType="vm:RulesetEditorViewModel">
                                <StackPanel Spacing="16">
                                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EntryHead}" />
                                  <StackPanel Spacing="16" IsVisible="{Binding Manages}">
                                    <Border Classes="fields">
                                      <StackPanel Margin="0,-1,0,0">
                                        <ContentControl Content="{Binding Target}" ContentTemplate="{StaticResource ChoiceRow}" />
                                        <ContentControl Content="{Binding Enforcement}" ContentTemplate="{StaticResource ChoiceRow}" />
                                        <ContentControl Content="{Binding Bypass}" ContentTemplate="{StaticResource ChoiceRow}" />
                                        <Border Classes="field">
                                          <Grid ColumnDefinitions="180,*" Margin="16,10">
                                            <StackPanel Spacing="2">
                                              <TextBlock Text="Branches and tags" FontWeight="SemiBold" FontSize="14" />
                                              <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="0,0,12,0"
                                                         Text="One pattern per line. ~DEFAULT_BRANCH is the default branch, and ~ALL is every one. Leave both empty to keep the repository's own." />
                                            </StackPanel>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,16,*">
                                              <StackPanel Spacing="4">
                                                <TextBlock Classes="small" Text="Include" />
                                                <TextBox Classes="mono" AcceptsReturn="True" MinHeight="64" Text="{Binding Include}"
                                                         AutomationProperties.Name="Patterns to include" />
                                              </StackPanel>
                                              <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock Classes="small" Text="Exclude" />
                                                <TextBox Classes="mono" AcceptsReturn="True" MinHeight="64" Text="{Binding Exclude}"
                                                         AutomationProperties.Name="Patterns to exclude" />
                                              </StackPanel>
                                            </Grid>
                                          </Grid>
                                        </Border>
                                      </StackPanel>
                                    </Border>

                                    <StackPanel Spacing="6">
                                      <TextBlock Classes="h2" Text="Rules" />
                                      <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding LeavesRules}"
                                                 Text="The YAML leaves this ruleset's rules as GitHub has them. Turn one on here and the profile lists every rule the ruleset keeps, so GitHub drops any other." />
                                      <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding HasOthers}"
                                                 Text="{Binding OthersNote}" />
                                    </StackPanel>
                                    <Border Classes="fields">
                                      <ItemsControl ItemsSource="{Binding Rules}" Margin="0,-1,0,0">
                                        <ItemsControl.DataTemplates>
                                          <DataTemplate DataType="vm:PullRequestRuleViewModel">
                                            <Border Classes="field">
                                              <StackPanel Margin="16,12" Spacing="10">
                                                <CheckBox IsChecked="{Binding Enabled}" AutomationProperties.HelpText="{Binding Description}">
                                                  <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                    <TextBlock Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" />
                                                  </StackPanel>
                                                </CheckBox>
                                                <StackPanel Margin="28,0,0,0" Spacing="8" IsVisible="{Binding Enabled}">
                                                  <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <NumericUpDown Classes.dim="{Binding Approvals.Dim}" Value="{Binding Approvals.Number}"
                                                                   Minimum="0" Maximum="10" Increment="1" FormatString="0" Width="120"
                                                                   AutomationProperties.Name="{Binding Approvals.Label}"
                                                                   AutomationProperties.HelpText="{Binding Approvals.HelpText}" />
                                                    <TextBlock Text="{Binding Approvals.Label}" VerticalAlignment="Center" />
                                                  </StackPanel>
                                                  <ItemsControl ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource FlagRow}" />
                                                  <StackPanel Spacing="4">
                                                    <TextBlock Classes="small" Text="Allowed merge methods" />
                                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                                      <CheckBox Classes.dim="{Binding Methods.Dim}" IsChecked="{Binding Methods.Merge}" Content="Merge"
                                                                AutomationProperties.Name="Allowed merge method: Merge"
                                                                AutomationProperties.HelpText="{Binding Methods.HelpText}" />
                                                      <CheckBox Classes.dim="{Binding Methods.Dim}" IsChecked="{Binding Methods.Squash}" Content="Squash"
                                                                AutomationProperties.Name="Allowed merge method: Squash"
                                                                AutomationProperties.HelpText="{Binding Methods.HelpText}" />
                                                      <CheckBox Classes.dim="{Binding Methods.Dim}" IsChecked="{Binding Methods.Rebase}" Content="Rebase"
                                                                AutomationProperties.Name="Allowed merge method: Rebase"
                                                                AutomationProperties.HelpText="{Binding Methods.HelpText}" />
                                                    </StackPanel>
                                                  </StackPanel>
                                                  <TextBlock Classes="small" Foreground="{DynamicResource RemoveBrush}" Text="{Binding Problem}"
                                                             IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                </StackPanel>
                                              </StackPanel>
                                            </Border>
                                          </DataTemplate>
                                          <DataTemplate DataType="vm:StatusChecksRuleViewModel">
                                            <Border Classes="field">
                                              <StackPanel Margin="16,12" Spacing="10">
                                                <CheckBox IsChecked="{Binding Enabled}" AutomationProperties.HelpText="{Binding Description}">
                                                  <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                    <TextBlock Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" />
                                                  </StackPanel>
                                                </CheckBox>
                                                <StackPanel Margin="28,0,0,0" Spacing="8" IsVisible="{Binding Enabled}">
                                                  <StackPanel Spacing="4">
                                                    <TextBlock Classes="small" Text="Checks that must pass, one per line" />
                                                    <TextBox Classes="mono" AcceptsReturn="True" MinHeight="64" MaxWidth="480"
                                                             HorizontalAlignment="Left" MinWidth="320" Text="{Binding Contexts}"
                                                             AutomationProperties.Name="Checks that must pass" />
                                                  </StackPanel>
                                                  <ContentControl Content="{Binding Strict}" ContentTemplate="{StaticResource FlagRow}" />
                                                  <TextBlock Classes="small" Foreground="{DynamicResource RemoveBrush}" Text="{Binding Problem}"
                                                             IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                </StackPanel>
                                              </StackPanel>
                                            </Border>
                                          </DataTemplate>
                                          <DataTemplate DataType="vm:RuleViewModel">
                                            <Border Classes="field">
                                              <CheckBox Margin="16,12" IsChecked="{Binding Enabled}"
                                                        AutomationProperties.HelpText="{Binding Description}">
                                                <StackPanel Spacing="2">
                                                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                  <TextBlock Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" />
                                                </StackPanel>
                                              </CheckBox>
                                            </Border>
                                          </DataTemplate>
                                        </ItemsControl.DataTemplates>
                                      </ItemsControl>
                                    </Border>
                                  </StackPanel>
                                </StackPanel>
                              </DataTemplate>
                              <DataTemplate DataType="vm:EnvironmentEditorViewModel">
                                <StackPanel Spacing="16">
                                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EntryHead}" />
                                  <Border Classes="fields" IsVisible="{Binding Manages}">
                                    <StackPanel Margin="0,-1,0,0">
                                      <Border Classes="field" MinHeight="56">
                                        <Grid ColumnDefinitions="180,*" Margin="16,10">
                                          <TextBlock Text="Wait timer" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                            <TextBox Width="120" Text="{Binding WaitTimer}" PlaceholderText="Not set"
                                                     AutomationProperties.Name="Wait timer in minutes"
                                                     AutomationProperties.HelpText="Leave it empty and the repository keeps its own." />
                                            <TextBlock Classes="muted small" VerticalAlignment="Center"
                                                       Text="Minutes before a deployment starts. Empty leaves the repository's own." />
                                          </StackPanel>
                                        </Grid>
                                      </Border>
                                      <ContentControl Content="{Binding Reviewers}" ContentTemplate="{StaticResource ChoiceRow}" />
                                      <ContentControl Content="{Binding SelfReview}" ContentTemplate="{StaticResource ChoiceRow}" />
                                      <ContentControl Content="{Binding Deployments}" ContentTemplate="{StaticResource ChoiceRow}" />
                                      <Border Classes="field" IsVisible="{Binding ShowPatterns}">
                                        <Grid ColumnDefinitions="180,*" Margin="16,10">
                                          <StackPanel Spacing="2">
                                            <TextBlock Text="Which ones" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="0,0,12,0"
                                                       Text="Name patterns, one per line, such as main or releases/*." />
                                          </StackPanel>
                                          <Grid Grid.Column="1" ColumnDefinitions="*,16,*">
                                            <StackPanel Spacing="4">
                                              <TextBlock Classes="small" Text="Branches" />
                                              <TextBox Classes="mono" AcceptsReturn="True" MinHeight="64" Text="{Binding Branches}"
                                                       AutomationProperties.Name="Branches that may deploy" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="4">
                                              <TextBlock Classes="small" Text="Tags" />
                                              <TextBox Classes="mono" AcceptsReturn="True" MinHeight="64" Text="{Binding Tags}"
                                                       AutomationProperties.Name="Tags that may deploy" />
                                            </StackPanel>
                                          </Grid>
                                        </Grid>
                                      </Border>
                                    </StackPanel>
                                  </Border>
                                </StackPanel>
                              </DataTemplate>
                              <DataTemplate DataType="vm:LabelEditorViewModel">
                                <StackPanel Spacing="16">
                                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EntryHead}" />
                                  <Border Classes="fields" IsVisible="{Binding Manages}">
                                    <StackPanel Margin="0,-1,0,0">
                                      <Border Classes="field" MinHeight="56">
                                        <Grid ColumnDefinitions="180,*" Margin="16,10">
                                          <TextBlock Text="Color" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Top" Margin="0,8,0,0" />
                                          <StackPanel Grid.Column="1" Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                              <Border Classes="swatch" Background="{Binding Hex, Converter={x:Static theme:LabelChip.Brush}}" />
                                              <TextBox Classes="mono" Width="150" Text="{Binding Color}" PlaceholderText="Not set"
                                                       AutomationProperties.Name="Label color"
                                                       AutomationProperties.HelpText="Six hex digits, with or without #. Leave it empty and each repository keeps its own." />
                                              <TextBlock Classes="muted small" VerticalAlignment="Center" TextWrapping="Wrap"
                                                         Text="Six hex digits, with or without #. Empty leaves each repository's own." />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Swatches}" AutomationProperties.Name="GitHub's label colors">
                                              <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                  <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                                </ItemsPanelTemplate>
                                              </ItemsControl.ItemsPanel>
                                              <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LabelSwatchViewModel">
                                                  <Button Classes="swatch" Classes.chosen="{Binding IsChosen}"
                                                          Command="{Binding Editor.PickCommand}" CommandParameter="{Binding Hex}"
                                                          AutomationProperties.Name="{Binding AccessibleName}"
                                                          ToolTip.Tip="{Binding AccessibleName}">
                                                    <Border Background="{Binding Hex, Converter={x:Static theme:LabelChip.Brush}}" />
                                                  </Button>
                                                </DataTemplate>
                                              </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                          </StackPanel>
                                        </Grid>
                                      </Border>
                                      <Border Classes="field" MinHeight="56">
                                        <Grid ColumnDefinitions="180,*" Margin="16,10">
                                          <TextBlock Text="Description" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Top" Margin="0,8,0,0" />
                                          <StackPanel Grid.Column="1" Spacing="6">
                                            <Grid>
                                              <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MaxWidth="640" />
                                              </Grid.ColumnDefinitions>
                                              <TextBox Text="{Binding Description}" IsEnabled="{Binding SetsDescription}"
                                                       AutomationProperties.Name="Label description"
                                                       AutomationProperties.HelpText="{Binding DescriptionNote}" />
                                            </Grid>
                                            <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding DescriptionNote}" />
                                            <CheckBox IsChecked="{Binding KeepsDescription}" Content="Leave each repository's own description" />
                                          </StackPanel>
                                        </Grid>
                                      </Border>
                                      <Border Classes="field" MinHeight="56">
                                        <Grid ColumnDefinitions="180,*" Margin="16,10">
                                          <TextBlock Text="Preview" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                            <Border Classes="chip" Background="{Binding Hex, Converter={x:Static theme:LabelChip.Brush}}"
                                                    IsVisible="{Binding Hex, Converter={x:Static ObjectConverters.IsNotNull}}">
                                              <TextBlock Text="{Binding Name}" Foreground="{Binding Ink, Converter={x:Static theme:LabelChip.Brush}}" />
                                            </Border>
                                            <Border Classes="chip plain" IsVisible="{Binding Hex, Converter={x:Static ObjectConverters.IsNull}}">
                                              <TextBlock Text="{Binding Name}" />
                                            </Border>
                                            <TextBlock Classes="muted small" VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Text="Text on the label turns dark or light to stay readable on its color." />
                                          </StackPanel>
                                        </Grid>
                                      </Border>
                                    </StackPanel>
                                  </Border>
                                </StackPanel>
                              </DataTemplate>
                            </ContentControl.DataTemplates>
                          </ContentControl>
                        </StackPanel>
                      </StackPanel>
                    </Panel>
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
            </Panel>
          </ScrollViewer>
        </DockPanel>

        <!-- The file as saved, or what the last plan changes, as a diff of the same YAML -->
        <Border Grid.Column="1" Classes="panel" Width="{Binding YamlWidth}" Margin="24,0,0,0" VerticalAlignment="Stretch"
                IsVisible="{Binding ShowYaml}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,10" IsVisible="{Binding HasDiff}">
              <Border Classes="seg">
                <StackPanel Orientation="Horizontal">
                  <ToggleButton Classes="seg" Classes.on="{Binding ShowingDiff}" IsChecked="{Binding ShowingDiff, Mode=OneWay}"
                                Content="Diff" Command="{Binding ShowDiffCommand}"
                                AutomationProperties.HelpText="Shows what GitHub has now against what it has after this apply." />
                  <ToggleButton Classes="seg" Classes.on="{Binding ShowingFile}" IsChecked="{Binding ShowingFile, Mode=OneWay}"
                                Content="File" Command="{Binding ShowFileCommand}"
                                AutomationProperties.HelpText="Shows the file as saved." />
                </StackPanel>
              </Border>
              <TextBlock Grid.Column="1" Classes="mono muted small" HorizontalAlignment="Right" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Margin="12,0,0,0" Text="{Binding FileName}" IsVisible="{Binding ShowingDiff}" />
            </Grid>

            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,12" IsVisible="{Binding ShowingFile}">
              <TextBlock Classes="mono" FontWeight="SemiBold" Text="{Binding FileName}" />
              <TextBlock Classes="muted small" Text="As saved. Save to see your changes here." TextWrapping="Wrap"
                         IsVisible="{Binding HasChanges}" />
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" IsVisible="{Binding ShowingFile}">
              <SelectableTextBlock Classes="yaml" Text="{Binding Yaml}" />
            </ScrollViewer>

            <DockPanel IsVisible="{Binding ShowingDiff}">
              <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,12">
                <TextBlock Classes="small" TextWrapping="Wrap">
                  <Run FontWeight="SemiBold" Text="GitHub now" />
                  <Run Foreground="{DynamicResource MutedBrush}" Text="against" />
                  <Run FontWeight="SemiBold" Text="after this apply" />
                </TextBlock>
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Shows saved edits. Save to see the rest here."
                           IsVisible="{Binding HasChanges}" />
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="GitHub already has everything here."
                           IsVisible="{Binding Diff.Matches, FallbackValue=False}" />
              </StackPanel>
              <TextBlock DockPanel.Dock="Bottom" Classes="muted small" Margin="0,10,0,0" TextWrapping="Wrap"
                         Text="{Binding Diff.Footnote, FallbackValue={x:Null}}" IsVisible="{Binding Diff.HasFootnote, FallbackValue=False}" />
              <Border Classes="diff">
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Diff.Items, FallbackValue={x:Null}}" Tag="{Binding Diff}" AutomationProperties.Name="Diff">
                    <ItemsControl.DataTemplates>
                      <DataTemplate DataType="vm:DiffLine">
                        <Border Classes="diffline" Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}"
                                AutomationProperties.AccessibilityView="Content" AutomationProperties.Name="{Binding AccessibleName}">
                          <Panel>
                            <Grid ColumnDefinitions="22,*,Auto" IsVisible="{Binding !IsNote}">
                              <TextBlock Classes="sign" Text="{Binding Sign}" AutomationProperties.AccessibilityView="Raw" />
                              <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Classes="line indent" xml:space="preserve" Text="{Binding Indent}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Classes="line" Classes.removed="{Binding IsRemoved}" Text="{Binding Value}" AutomationProperties.AccessibilityView="Raw" />
                              </StackPanel>
                              <Border Grid.Column="2" Classes="chip" Margin="12,0,8,0" Padding="6,0" VerticalAlignment="Center" IsVisible="{Binding HasTag}">
                                <TextBlock FontSize="12" Text="{Binding Tag}" AutomationProperties.AccessibilityView="Raw" />
                              </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="22,3,10,3" IsVisible="{Binding IsNote}">
                              <Path Classes="lock" VerticalAlignment="Center" IsVisible="{Binding Locked}" />
                              <TextBlock Classes="muted small" FontSize="12.5" TextWrapping="Wrap" Text="{Binding Text}" AutomationProperties.AccessibilityView="Raw" />
                            </StackPanel>
                          </Panel>
                        </Border>
                      </DataTemplate>
                      <DataTemplate DataType="vm:DiffFold">
                        <Border Classes="difffold">
                          <Button Classes="link" Margin="22,0,0,0" FontSize="13" Content="{Binding Label}"
                                  Command="{Binding $parent[ItemsControl].((vm:PlanDiffViewModel)Tag).UnfoldCommand, FallbackValue={x:Null}}"
                                  CommandParameter="{Binding}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.DataTemplates>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </DockPanel>
          </DockPanel>
        </Border>
      </Grid>
    </Panel>
  </DockPanel>
</UserControl>
