<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Repotted.Desktop.ViewModels"
             xmlns:views="using:Repotted.Desktop.Views"
             x:Class="Repotted.Desktop.Views.CompareView"
             x:DataType="vm:CompareViewModel">
  <DockPanel>
    <!-- Heading and actions -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="32,24,32,0">
      <StackPanel Spacing="6">
        <TextBlock Classes="h1" Text="{Binding Heading}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" IsVisible="{Binding ShowResult}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Button Classes="quiet" Content="Compare again" Command="{Binding LoadCommand}" />
        <Button Classes="primary" Content="Apply" Command="{Binding ApplyCommand}" IsVisible="{Binding CanApply}"
                AutomationProperties.HelpText="Shows these changes to edit before anything is written to GitHub." />
      </StackPanel>
    </Grid>

    <Panel Margin="32,20,32,0">
      <TextBlock Classes="muted" Text="Comparing with GitHub" IsVisible="{Binding Loading}" />

      <StackPanel Spacing="12" IsVisible="{Binding HasError}">
        <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource RemoveBrush}" />
      </StackPanel>

      <DockPanel IsVisible="{Binding ShowResult}">
        <!-- The search, and whether matching settings show too -->
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
          <TextBox x:Name="CompareSearch" Classes="search" Width="300" Margin="0,0,12,0" VerticalAlignment="Center"
                   PlaceholderText="Search this compare" Text="{Binding Query}"
                   AutomationProperties.Name="Search this compare"
                   AutomationProperties.HelpText="Finds rows by setting name, description, API field name, ruleset, or environment.">
            <TextBox.InnerRightContent>
              <Border Classes="kbd" Margin="6,0,0,0" IsHitTestVisible="False">
                <TextBlock x:Name="SearchShortcut" Classes="mono muted" FontSize="12" Text="Ctrl F" />
              </Border>
            </TextBox.InnerRightContent>
          </TextBox>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ToggleButton Classes="chip" Content="Differs from GitHub" IsChecked="{Binding DifferencesOnly}"
                          AutomationProperties.HelpText="Shows only what the profile would change. Turn it off to see matching settings too." />
            <ToggleButton Classes="chip" Content="Can't change" IsChecked="{Binding LockedOnly}" IsVisible="{Binding HasLocks}"
                          AutomationProperties.HelpText="Shows only the differences Repotted can't change, each with what it needs." />
            <Button Classes="link" Margin="4,0,0,0" Content="Clear" IsVisible="{Binding Query, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Command="{Binding ClearSearchCommand}" AutomationProperties.Name="Clear the search" />
          </StackPanel>
        </WrapPanel>

        <!-- What the rails mean -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="20" Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="legend" Background="{DynamicResource DriftRailBrush}" />
            <TextBlock Classes="muted small" Text="Profile changes it" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="legend" Background="{DynamicResource RailBrush}" />
            <TextBlock Classes="muted small" Text="Profile adds it" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="legend" Background="{DynamicResource RemoveBrush}" />
            <TextBlock Classes="muted small" Text="Profile removes it" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="legend" Background="{DynamicResource RailInheritedBrush}" />
            <TextBlock Classes="muted small" Text="Already matches" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Warnings}" Margin="0,0,0,12" IsVisible="{Binding HasWarnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource DriftBrush}" Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="{Binding NothingFoundMessage}" IsVisible="{Binding NothingFound}"
                   AutomationProperties.LiveSetting="Polite" />

        <!-- Changes the App or the account's role can't make, before anyone tries to apply them -->
        <Border DockPanel.Dock="Top" Classes="locks" Margin="0,0,0,12" IsVisible="{Binding HasLocks}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Classes="lock" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Classes="small" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="{Binding LockSummary}" AutomationProperties.LiveSetting="Polite" />
            <Button Grid.Column="2" Classes="link" Margin="16,0,0,0" Content="{Binding AccessLabel}"
                    Command="{Binding ReviewAccessCommand}" IsVisible="{Binding HasAccessUrl}" />
          </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Top" Classes="muted small" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="{Binding DraftsNote}"
                   IsVisible="{Binding DraftsNote, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <ScrollViewer>
          <Border Classes="fields" VerticalAlignment="Top" Margin="0,0,0,32" IsVisible="{Binding !NothingFound}">
            <views:PlanTable Sections="{Binding Sections}" WantedHeader="In the profile" />
          </Border>
        </ScrollViewer>
      </DockPanel>
    </Panel>
  </DockPanel>
</UserControl>
