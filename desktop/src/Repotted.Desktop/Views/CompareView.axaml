<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Repotted.Desktop.ViewModels"
             x:Class="Repotted.Desktop.Views.CompareView"
             x:DataType="vm:CompareViewModel">
  <DockPanel>
    <!-- Heading and actions -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="32,24,32,0">
      <StackPanel Spacing="6">
        <TextBlock Classes="h1" Text="{Binding Heading}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" IsVisible="{Binding ShowResult}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Button Classes="quiet" Content="{Binding EverythingLabel}" Command="{Binding ToggleEverythingCommand}"
                IsVisible="{Binding ShowResult}" />
        <Button Classes="quiet" Content="Compare again" Command="{Binding LoadCommand}" />
        <Button Classes="primary" Content="Apply" Command="{Binding ApplyCommand}" IsVisible="{Binding CanApply}"
                AutomationProperties.HelpText="Shows these changes to edit before anything is written to GitHub." />
      </StackPanel>
    </Grid>

    <Panel Margin="32,20,32,0">
      <TextBlock Classes="muted" Text="Comparing with GitHub" IsVisible="{Binding Loading}" />

      <StackPanel Spacing="12" IsVisible="{Binding HasError}">
        <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource RemoveBrush}" />
      </StackPanel>

      <DockPanel IsVisible="{Binding ShowResult}">
        <!-- What the rails mean -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="20" Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="legend" Background="{DynamicResource DriftRailBrush}" />
            <TextBlock Classes="muted small" Text="Profile changes it" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="legend" Background="{DynamicResource RailBrush}" />
            <TextBlock Classes="muted small" Text="Profile adds it" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="legend" Background="{DynamicResource RemoveBrush}" />
            <TextBlock Classes="muted small" Text="Profile removes it" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="legend" Background="{DynamicResource RailInheritedBrush}" />
            <TextBlock Classes="muted small" Text="Already matches" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Warnings}" Margin="0,0,0,12" IsVisible="{Binding HasWarnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource DriftBrush}" Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Changes the App or the account's role can't make, before anyone tries to apply them -->
        <Border DockPanel.Dock="Top" Classes="locks" Margin="0,0,0,12" IsVisible="{Binding HasLocks}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Classes="lock" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Classes="small" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="{Binding LockSummary}" />
            <Button Grid.Column="2" Classes="link" Margin="16,0,0,0" Content="{Binding AccessLabel}"
                    Command="{Binding ReviewAccessCommand}" IsVisible="{Binding HasAccessUrl}" />
          </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Top" Classes="muted small" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="{Binding DraftsNote}"
                   IsVisible="{Binding DraftsNote, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <ScrollViewer>
          <Border Classes="fields" VerticalAlignment="Top" Margin="0,0,0,32">
            <StackPanel>
              <Grid ColumnDefinitions="4,*,*,*" Background="{DynamicResource SunkenBrush}">
                <Grid.Styles>
                  <Style Selector="TextBlock">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                    <Setter Property="Margin" Value="16,9" />
                  </Style>
                </Grid.Styles>
                <TextBlock Grid.Column="1" Text="Setting" />
                <TextBlock Grid.Column="2" Text="On GitHub now" />
                <TextBlock Grid.Column="3" Text="In the profile" />
              </Grid>

              <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CompareSectionViewModel">
                    <StackPanel>
                      <Border Classes="field" MinHeight="52">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="20,0" VerticalAlignment="Center">
                          <TextBlock Classes="h2" FontSize="15" Text="{Binding Title}" VerticalAlignment="Center" />
                          <Border Classes="pill" Classes.ok="{Binding InLine}" Classes.drift="{Binding HasChanges}"
                                  Classes.none="{Binding Skipped}">
                            <StackPanel Orientation="Horizontal"><Ellipse /><TextBlock Text="{Binding Status}" /></StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>

                      <ListBox Classes="rows" ItemsSource="{Binding Rows}" AutomationProperties.Name="{Binding Title}">
                        <ListBox.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                          <Style Selector="ListBoxItem" x:DataType="vm:CompareRow">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                          </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:CompareRow">
                            <Border Classes="field" Classes.change="{Binding IsChange}" Classes.add="{Binding IsAdd}"
                                    Classes.remove="{Binding IsRemove}">
                              <Grid ColumnDefinitions="4,*,*,*">
                                <Border Classes="rail" Classes.change="{Binding IsChange}" Classes.add="{Binding IsAdd}"
                                        Classes.remove="{Binding IsRemove}" Classes.match="{Binding IsMatch}" />
                                <StackPanel Grid.Column="1" Margin="16,10" VerticalAlignment="Center" Spacing="2">
                                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14.5" TextWrapping="Wrap" />
                                  <TextBlock Classes="mono muted" FontSize="12.5" Text="{Binding Key}" TextWrapping="Wrap" />
                                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" IsVisible="{Binding IsLocked}">
                                    <Path Classes="lock" VerticalAlignment="Center" />
                                    <TextBlock Classes="muted small" Text="{Binding Lock}" TextWrapping="Wrap" />
                                  </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Margin="16,10" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Classes.gone="{Binding NowGoes}" Text="{Binding Now}" />
                                <TextBlock Grid.Column="3" Margin="16,10" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Classes="wanted" Classes.removed="{Binding IsRemove}" Classes.same="{Binding IsMatch}"
                                           Text="{Binding Wanted}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>

                      <Border Classes="field" MinHeight="44" IsVisible="{Binding HasSummary}">
                        <TextBlock Classes="muted" Margin="20,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding Summary}" />
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </DockPanel>
    </Panel>
  </DockPanel>
</UserControl>
