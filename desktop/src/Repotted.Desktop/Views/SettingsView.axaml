<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Repotted.Desktop.ViewModels"
             xmlns:views="using:Repotted.Desktop.Views"
             x:Class="Repotted.Desktop.Views.SettingsView"
             x:DataType="vm:ShellViewModel">
  <!-- The settings as a page, where they aren't a window of their own -->
  <ScrollViewer>
    <StackPanel Margin="32,24" Spacing="28" MaxWidth="760" HorizontalAlignment="Left">
      <StackPanel Spacing="6">
        <TextBlock Classes="h1" Text="Settings" />
        <TextBlock Classes="muted" Text="For the whole app, on this computer." />
      </StackPanel>
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Account" />
        <views:SettingsAccountView />
      </StackPanel>
      <StackPanel Spacing="10">
        <StackPanel Spacing="4">
          <TextBlock Classes="h2" Text="Profiles" />
          <TextBlock Classes="muted small" Text="Where your profiles are kept." />
        </StackPanel>
        <views:SettingsProfilesView />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
