<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Repotted.Desktop.ViewModels"
             x:Class="Repotted.Desktop.Views.SettingsAccountView"
             x:DataType="vm:ShellViewModel">
  <!-- Who is signed in, and how -->
  <Border Classes="settings">
    <Border Classes="settingrow first">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Classes="avatar large" VerticalAlignment="Center">
          <TextBlock Text="{Binding Initials}" FontSize="14" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,16,0" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding Account.Login}" FontWeight="SemiBold" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding SignedInWith}"
                     IsVisible="{Binding SignedInWith, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="quiet" Content="Add repositories" IsVisible="{Binding Repositories.CanAddRepositories}"
                  Command="{Binding Repositories.AddRepositoriesCommand}" />
          <Button Classes="quiet" Content="Sign out" IsVisible="{Binding ShowSignOut}" Command="{Binding SignOutCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </Border>
</UserControl>
