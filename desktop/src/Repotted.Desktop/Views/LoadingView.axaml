<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Repotted.Desktop.ViewModels"
             xmlns:views="using:Repotted.Desktop.Views"
             x:Class="Repotted.Desktop.Views.LoadingView"
             x:DataType="vm:LoadingViewModel">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
    <views:BrandMark HorizontalAlignment="Center" Width="40" Height="40" />
    <TextBlock Classes="muted" Text="{Binding Message}" HorizontalAlignment="Center" />
    <ProgressBar IsIndeterminate="True" Width="160" Foreground="{DynamicResource RailBrush}"
                 Background="{DynamicResource SunkenBrush}" />
  </StackPanel>
</UserControl>
