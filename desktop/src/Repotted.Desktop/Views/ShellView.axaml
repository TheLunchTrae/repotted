<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Repotted.Desktop.ViewModels"
             xmlns:views="using:Repotted.Desktop.Views"
             xmlns:theme="using:Repotted.Desktop.Theme"
             x:Class="Repotted.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <Grid RowDefinitions="44,*" ColumnDefinitions="248,*">
    <!-- Header: where you are, and the account -->
    <Border Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0,10,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Crumb}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button x:Name="AccountButton" Grid.Column="1" Classes="account" VerticalAlignment="Center"
                AutomationProperties.Name="Account" ToolTip.Tip="{Binding SignedInWith}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="avatar">
              <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Account.Login}" FontSize="13.5" VerticalAlignment="Center" />
            <Path Classes="icon chevron" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="menu">
              <StackPanel x:Name="AccountMenu" Width="260" Spacing="2">
                <Grid ColumnDefinitions="Auto,*" Margin="10,8,10,10">
                  <Border Classes="avatar" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                    <TextBlock Text="{Binding Account.Login}" FontWeight="Bold" FontSize="13.5" />
                    <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" Text="{Binding SignedInWith}"
                               IsVisible="{Binding SignedInWith, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,4" />
                <Button Classes="menuitem" Content="Add repositories"
                        IsVisible="{Binding Repositories.CanAddRepositories}"
                        Command="{Binding Repositories.AddRepositoriesCommand}" />
                <Button Classes="menuitem" Command="{Binding OpenSettingsCommand}"
                        AutomationProperties.Name="{Binding SettingsLabel}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding SettingsLabel}" />
                    <TextBlock Grid.Column="1" Classes="muted mono" FontSize="12.5" Margin="16,0,0,0"
                               Text="{x:Static vm:ShellViewModel.SettingsShortcut}" />
                  </Grid>
                </Button>
                <StackPanel Spacing="2" IsVisible="{Binding ShowSignOut}">
                  <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4" />
                  <Button Classes="menuitem" Content="Sign out" Command="{Binding SignOutCommand}" />
                </StackPanel>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <!-- Sidebar -->
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="8,0,8,20">
          <views:BrandMark />
          <TextBlock Text="Repotted" FontWeight="Bold" FontSize="17" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Windows keeps the settings at the foot of the navigation; macOS opens them in a window. -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="0,10,0,0" IsVisible="{Binding !SettingsInWindow}">
          <ListBox x:Name="SettingsNav" Classes="nav" SelectedIndex="{Binding SettingsNavPage}"
                   AutomationProperties.Name="Settings">
            <ListBoxItem AutomationProperties.Name="Settings">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Classes="icon gear" />
                <TextBlock Text="Settings" />
              </StackPanel>
            </ListBoxItem>
          </ListBox>
        </Border>

        <DockPanel>
          <ListBox x:Name="Nav" DockPanel.Dock="Top" Classes="nav" SelectedIndex="{Binding NavPage}" AutomationProperties.Name="Main">
            <ListBoxItem AutomationProperties.Name="Repositories">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Repositories" />
                <TextBlock Grid.Column="1" Classes="muted" FontSize="13" FontWeight="Normal"
                           Text="{Binding Repositories.Count}" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem AutomationProperties.Name="Profiles">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Profiles" />
                <TextBlock Grid.Column="1" Classes="muted" FontSize="13" FontWeight="Normal"
                           Text="{Binding Profiles.Count}" />
              </Grid>
            </ListBoxItem>
          </ListBox>

          <!-- The profiles in the folder, while the profiles page is open -->
          <DockPanel IsVisible="{Binding ShowingProfiles}" Margin="0,18,0,12">
            <Button DockPanel.Dock="Bottom" Classes="quiet" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                    Content="New profile" Command="{Binding Profiles.StartNewCommand}" CommandParameter="{x:Null}" />
            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,6" IsVisible="{Binding Profiles.HasProfiles}">
              <Grid ColumnDefinitions="*,Auto" Margin="12,0,0,0">
                <TextBlock Classes="muted small" FontWeight="SemiBold" VerticalAlignment="Center"
                           Text="{Binding Profiles.Folder.ListLabel}" />
                <Button x:Name="SyncButton" Grid.Column="1" Classes="iconbutton" Command="{Binding Profiles.RefreshCommand}"
                        ToolTip.Tip="{Binding Profiles.Folder.RefreshLabel}"
                        AutomationProperties.Name="{Binding Profiles.Folder.RefreshLabel}">
                  <Path Classes="icon sync" />
                </Button>
              </Grid>
              <TextBox x:Name="ProfileFilter" Classes="search side" PlaceholderText="Find a profile"
                       Text="{Binding Profiles.Filter}" AutomationProperties.Name="Find a profile" />
            </StackPanel>
            <ListBox x:Name="ProfileList" Classes="nav" ItemsSource="{Binding Profiles.Items}" SelectedItem="{Binding Profiles.Selected}"
                     AutomationProperties.Name="Profiles in this folder">
              <ListBox.Styles>
                <Style Selector="ListBoxItem" x:DataType="vm:ProfileItemViewModel">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                  <Setter Property="ContextMenu">
                    <ContextMenu>
                      <MenuItem Header="{theme:Label 'Delete profile'}" Command="{Binding DeleteCommand}"
                                InputGesture="{OnPlatform Default=Delete, macOS=Meta+Back}" />
                    </ContextMenu>
                  </Setter>
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileItemViewModel">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted" FontSize="12.5" FontWeight="Normal" Text="{Binding Note}"
                               IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </DockPanel>
      </DockPanel>
    </Border>

    <Panel Grid.Row="1" Grid.Column="1" IsVisible="{Binding ShowingRepositories}">
      <views:RepositoriesView DataContext="{Binding Repositories}" />
    </Panel>
    <DockPanel Grid.Row="1" Grid.Column="1" IsVisible="{Binding ShowingCompare}">
      <Button DockPanel.Dock="Top" Classes="link" Margin="32,16,32,0" HorizontalAlignment="Left"
              Content="Back to repositories" Command="{Binding CloseCompareCommand}" />
      <ContentControl Content="{Binding Compare}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:CompareViewModel"><views:CompareView /></DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>
    <DockPanel Grid.Row="1" Grid.Column="1" IsVisible="{Binding ShowingApply}">
      <Button DockPanel.Dock="Top" Classes="link" Margin="32,16,32,0" HorizontalAlignment="Left"
              Content="Back to repositories" Command="{Binding Apply.CloseCommand, FallbackValue={x:Null}}" />
      <ContentControl Content="{Binding Apply}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:ApplyViewModel"><views:ApplyView /></DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>
    <DockPanel Grid.Row="1" Grid.Column="1" IsVisible="{Binding ShowingBatch}">
      <Button DockPanel.Dock="Top" Classes="link" Margin="32,16,32,0" HorizontalAlignment="Left"
              Content="Back to repositories" Command="{Binding Batch.CloseCommand, FallbackValue={x:Null}}" />
      <ContentControl Content="{Binding Batch}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:BatchViewModel"><views:BatchView /></DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>
    <Panel Grid.Row="1" Grid.Column="1" IsVisible="{Binding ShowingProfiles}">
      <views:ProfilesView DataContext="{Binding Profiles}" />
    </Panel>
    <Panel Grid.Row="1" Grid.Column="1" IsVisible="{Binding ShowingSettings}">
      <views:SettingsView />
    </Panel>
  </Grid>
</UserControl>
