<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Repotted.Desktop.ViewModels"
             xmlns:views="using:Repotted.Desktop.Views"
             x:Class="Repotted.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <Grid RowDefinitions="44,*" ColumnDefinitions="248,*">
    <!-- Header: where you are, and the search -->
    <Border Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Crumb}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBox x:Name="SearchBox" Grid.Column="1" Classes="search" VerticalAlignment="Center"
                 PlaceholderText="{Binding SearchHint}" Text="{Binding Search}"
                 AutomationProperties.Name="{Binding SearchHint}">
          <TextBox.InnerRightContent>
            <Border Classes="kbd" Margin="6,0,0,0" IsHitTestVisible="False">
              <TextBlock x:Name="SearchShortcut" Classes="mono muted" FontSize="12" Text="Ctrl K" />
            </Border>
          </TextBox.InnerRightContent>
        </TextBox>
      </Grid>
    </Border>

    <!-- Sidebar -->
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="8,0,8,20">
          <views:BrandMark />
          <TextBlock Text="Repotted" FontWeight="Bold" FontSize="17" VerticalAlignment="Center" />
        </StackPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="8,14,8,0">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="avatar">
                <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{Binding Account.Login}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="muted" FontSize="13.5" TextWrapping="Wrap" Text="{Binding SignedInWith}"
                       IsVisible="{Binding SignedInWith, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Button Classes="link" Content="Add repositories" HorizontalAlignment="Left"
                    IsVisible="{Binding Repositories.CanAddRepositories}"
                    Command="{Binding Repositories.AddRepositoriesCommand}" />
            <Button Classes="link" Content="Sign out" HorizontalAlignment="Left"
                    IsVisible="{Binding ShowSignOut}" Command="{Binding SignOutCommand}" />
          </StackPanel>
        </Border>
        <DockPanel>
          <ListBox x:Name="Nav" DockPanel.Dock="Top" Classes="nav" SelectedIndex="{Binding Page}" AutomationProperties.Name="Main">
            <ListBoxItem AutomationProperties.Name="Repositories">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Repositories" />
                <TextBlock Grid.Column="1" Classes="muted" FontSize="13" FontWeight="Normal"
                           Text="{Binding Repositories.Count}" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem AutomationProperties.Name="Profiles">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Profiles" />
                <TextBlock Grid.Column="1" Classes="muted" FontSize="13" FontWeight="Normal"
                           Text="{Binding Profiles.Count}" />
              </Grid>
            </ListBoxItem>
          </ListBox>

          <!-- The profiles in the folder, while the profiles page is open -->
          <DockPanel IsVisible="{Binding ShowingProfiles}" Margin="0,18,0,12">
            <Button DockPanel.Dock="Bottom" Classes="quiet" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                    Content="New profile" Command="{Binding Profiles.StartNewCommand}" CommandParameter="{x:Null}" />
            <TextBlock DockPanel.Dock="Top" Classes="muted small" Margin="12,0,12,6" FontWeight="SemiBold"
                       Text="{Binding Profiles.Folder.ListLabel}" IsVisible="{Binding Profiles.HasProfiles}" />
            <ListBox Classes="nav" ItemsSource="{Binding Profiles.Items}" SelectedItem="{Binding Profiles.Selected}"
                     AutomationProperties.Name="Profiles in this folder">
              <ListBox.Styles>
                <Style Selector="ListBoxItem" x:DataType="vm:ProfileItemViewModel">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileItemViewModel">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted" FontSize="12.5" FontWeight="Normal" Text="{Binding Note}"
                               IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </DockPanel>
      </DockPanel>
    </Border>

    <Panel Grid.Row="1" Grid.Column="1" IsVisible="{Binding ShowingRepositories}">
      <views:RepositoriesView DataContext="{Binding Repositories}" />
    </Panel>
    <DockPanel Grid.Row="1" Grid.Column="1" IsVisible="{Binding ShowingCompare}">
      <Button DockPanel.Dock="Top" Classes="link" Margin="32,16,32,0" HorizontalAlignment="Left"
              Content="Back to repositories" Command="{Binding CloseCompareCommand}" />
      <ContentControl Content="{Binding Compare}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:CompareViewModel"><views:CompareView /></DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>
    <DockPanel Grid.Row="1" Grid.Column="1" IsVisible="{Binding ShowingApply}">
      <Button DockPanel.Dock="Top" Classes="link" Margin="32,16,32,0" HorizontalAlignment="Left"
              Content="Back to repositories" Command="{Binding Apply.CloseCommand, FallbackValue={x:Null}}" />
      <ContentControl Content="{Binding Apply}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:ApplyViewModel"><views:ApplyView /></DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>
    <DockPanel Grid.Row="1" Grid.Column="1" IsVisible="{Binding ShowingBatch}">
      <Button DockPanel.Dock="Top" Classes="link" Margin="32,16,32,0" HorizontalAlignment="Left"
              Content="Back to repositories" Command="{Binding Batch.CloseCommand, FallbackValue={x:Null}}" />
      <ContentControl Content="{Binding Batch}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:BatchViewModel"><views:BatchView /></DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>
    <Panel Grid.Row="1" Grid.Column="1" IsVisible="{Binding ShowingProfiles}">
      <views:ProfilesView DataContext="{Binding Profiles}" />
    </Panel>
  </Grid>
</UserControl>
