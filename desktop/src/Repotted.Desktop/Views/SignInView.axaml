<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Repotted.Desktop.ViewModels"
             xmlns:views="using:Repotted.Desktop.Views"
             x:Class="Repotted.Desktop.Views.SignInView"
             x:DataType="vm:SignInViewModel">
  <Border Classes="panel" Width="460" Padding="32,28" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <views:BrandMark />
        <TextBlock Text="Repotted" FontWeight="Bold" FontSize="17" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Classes="h1" Text="Sign in to GitHub" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Repotted reads and changes repository settings through the Repotted GitHub App. Signing in keeps a token in your system keychain." />
      </StackPanel>

      <!-- Before the code -->
      <StackPanel Spacing="12" IsVisible="{Binding ShowStart}">
        <Button Classes="primary" HorizontalAlignment="Stretch" Content="Sign in with GitHub"
                IsVisible="{Binding CanSignIn}" Command="{Binding SignInCommand}" />
        <Border IsVisible="{Binding HasNotice}" Background="{DynamicResource DriftBgBrush}" CornerRadius="8"
                Padding="12,8">
          <TextBlock Classes="small" TextWrapping="Wrap" Text="{Binding Notice}"
                     Foreground="{DynamicResource DriftBrush}" />
        </Border>
      </StackPanel>

      <!-- While GitHub hands out the code -->
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Starting}">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Width="40" MinWidth="40" Height="4" MinHeight="4"
                       Foreground="{DynamicResource RailBrush}" Background="{DynamicResource SunkenBrush}" />
          <TextBlock Classes="muted small" Text="Asking GitHub for a code" />
        </StackPanel>
        <Button Grid.Column="1" Classes="link" Content="Cancel" Command="{Binding SignInCancelCommand}" />
      </Grid>

      <!-- While the code waits -->
      <StackPanel Spacing="12" IsVisible="{Binding HasCode}">
        <TextBlock Classes="small" Text="Enter this code on GitHub to finish signing in." TextWrapping="Wrap" />
        <Border Classes="code">
          <Grid ColumnDefinitions="*,Auto">
            <SelectableTextBlock Classes="mono" Text="{Binding Code.UserCode, FallbackValue=''}"
                                 FontSize="24" FontWeight="Medium" LetterSpacing="2" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="quiet" Command="{Binding CopyCodeCommand}">
              <Panel>
                <TextBlock Text="Copy" IsVisible="{Binding !CodeCopied}" />
                <TextBlock Text="Copied" IsVisible="{Binding CodeCopied}" />
              </Panel>
            </Button>
          </Grid>
        </Border>
        <Button Classes="primary" HorizontalAlignment="Stretch" Content="Open GitHub"
                Command="{Binding OpenGitHubCommand}" />
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ProgressBar IsIndeterminate="True" Width="40" MinWidth="40" Height="4" MinHeight="4"
                         Foreground="{DynamicResource RailBrush}" Background="{DynamicResource SunkenBrush}" />
            <TextBlock Classes="muted small" Text="Waiting for GitHub" />
          </StackPanel>
          <Button Grid.Column="1" Classes="link" Content="Cancel" Command="{Binding SignInCancelCommand}" />
        </Grid>
      </StackPanel>

      <SelectableTextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Foreground="{DynamicResource RemoveBrush}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
