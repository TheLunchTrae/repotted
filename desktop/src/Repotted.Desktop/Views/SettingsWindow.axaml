<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Repotted.Desktop.ViewModels"
        xmlns:views="using:Repotted.Desktop.Views"
        x:Class="Repotted.Desktop.Views.SettingsWindow"
        x:DataType="vm:ShellViewModel"
        Title="{Binding SettingsTitle}"
        Icon="/Assets/repotted.ico"
        Width="640" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <!-- The settings as macOS shows them: a window with a tab for each pane -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,8,8,6">
      <ListBox x:Name="Tabs" Classes="toolbar" HorizontalAlignment="Center" SelectedIndex="{Binding SettingsTab}"
               AutomationProperties.Name="Settings">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBoxItem AutomationProperties.Name="Account">
          <StackPanel Spacing="3">
            <Path Classes="icon person" HorizontalAlignment="Center" />
            <TextBlock Text="Account" HorizontalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem AutomationProperties.Name="Profiles">
          <StackPanel Spacing="3">
            <Path Classes="icon folder" HorizontalAlignment="Center" />
            <TextBlock Text="Profiles" HorizontalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
      </ListBox>
    </Border>
    <Panel Margin="24,20,24,24">
      <views:SettingsAccountView IsVisible="{Binding SettingsTab, Converter={x:Static views:SettingsWindow.IsAccount}}" />
      <StackPanel Spacing="12" IsVisible="{Binding SettingsTab, Converter={x:Static views:SettingsWindow.IsProfiles}}">
        <TextBlock Classes="muted small" Text="Where your profiles are kept." />
        <views:SettingsProfilesView />
      </StackPanel>
    </Panel>
  </DockPanel>
</Window>
