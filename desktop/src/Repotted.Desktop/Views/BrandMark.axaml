<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Repotted.Desktop.Views.BrandMark"
             Width="26" Height="26">
  <!-- A seedling in a pot, from the mock-ups. -->
  <Viewbox>
    <Canvas Width="26" Height="26">
      <Path Data="M13 3c3 2 4 5 3 8-3 0-5-2-6-5 1-1 2-2 3-3Z"
            Fill="{DynamicResource PrimaryBrush}" Stroke="{DynamicResource RailBrush}" StrokeThickness="1.3" />
      <Path Data="M13 11v4" Stroke="{DynamicResource RailBrush}" StrokeThickness="1.6" />
      <Path Data="M6 15h14l-2 8H8l-2-8Z" Fill="{DynamicResource SurfaceBrush}"
            Stroke="{DynamicResource FgBrush}" StrokeThickness="1.6" StrokeJoin="Round" />
      <Path Data="M5 15h16" Stroke="{DynamicResource FgBrush}" StrokeThickness="1.6" StrokeLineCap="Round" />
    </Canvas>
  </Viewbox>
</UserControl>
