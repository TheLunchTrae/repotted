<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Repotted.Desktop.ViewModels"
             xmlns:views="using:Repotted.Desktop.Views"
             x:Class="Repotted.Desktop.Views.ProfilesView"
             x:DataType="vm:ProfilesViewModel">
  <DockPanel>
    <!-- Shown in every state, the empty folder included, because the usual folder to choose is a new one -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="32,10" IsVisible="{Binding HasNotice}">
      <TextBlock Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource RemoveBrush}" Text="{Binding Notice}"
                 AutomationProperties.LiveSetting="Assertive" />
    </Border>
    <!-- Changing the folder, connecting a repository, or quitting waits until unsaved changes are saved or discarded -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="32,10" IsVisible="{Binding HasLeaving}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="small" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource DriftBrush}"
                   Text="{Binding LeavingMessage}" AutomationProperties.LiveSetting="Assertive" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
          <Button Classes="quiet" Content="Save" Command="{Binding SaveAndLeaveCommand}" />
          <Button Classes="quiet" Content="Discard" Command="{Binding DiscardAndLeaveCommand}" />
          <Button Classes="quiet" Content="Cancel" Command="{Binding StayHereCommand}" />
        </StackPanel>
      </Grid>
    </Border>
    <!-- Deleting a profile waits for a yes that has seen what goes with it -->
    <Border DockPanel.Dock="Top" Classes="panel" Margin="32,16,32,0" IsVisible="{Binding AskingDelete}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding DeleteQuestion}" AutomationProperties.LiveSetting="Assertive" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding DeleteDetail}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
          <Button Classes="quiet" Content="Cancel" Command="{Binding CancelDeleteCommand}" />
          <Button Classes="primary" Content="Delete profile" Command="{Binding ConfirmDeleteCommand}" />
        </StackPanel>
      </Grid>
    </Border>
    <!-- A sync that failed, which the settings also say -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="32,10" IsVisible="{Binding ShowSyncProblem}">
      <Grid ColumnDefinitions="*,Auto">
        <SelectableTextBlock FontSize="13.5" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Folder.SyncNote}"
                             Foreground="{DynamicResource RemoveBrush}" AutomationProperties.LiveSetting="Assertive" />
        <Button Grid.Column="1" Classes="quiet" Margin="16,0,0,0" Content="{Binding Folder.RefreshLabel}"
                Command="{Binding RefreshCommand}" />
      </Grid>
    </Border>
    <!-- A file changed both here and on GitHub waits for a side -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="32,10" IsVisible="{Binding Folder.HasConflicts}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="small" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource DriftBrush}"
                   Text="{Binding Folder.ConflictMessage}" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
          <Button Classes="quiet" Content="Keep mine" Command="{Binding KeepMineCommand}" />
          <Button Classes="quiet" Content="Use GitHub's" Command="{Binding UseGitHubsCommand}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="32,10" IsVisible="{Binding HasCaptured}">
      <TextBlock Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource DriftBrush}" Text="{Binding Captured}" />
    </Border>

    <Panel>
      <TextBlock Classes="muted" Margin="32,24" Text="Loading profiles" IsVisible="{Binding Loading}" />

      <StackPanel Margin="32,24" Spacing="12" IsVisible="{Binding HasError}">
        <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource RemoveBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="quiet" Content="Try again" Command="{Binding RefreshCommand}" />
          <Button Classes="quiet" Content="{Binding Folder.FolderLabel}" Command="{Binding ChangeFolderCommand}" />
          <Button Classes="quiet" Content="{Binding Folder.RepositoryLabel}" Command="{Binding StartConnectCommand}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Margin="32,24" Spacing="12" MaxWidth="560" HorizontalAlignment="Left" IsVisible="{Binding ShowEmpty}">
        <TextBlock Classes="h1" Text="Profiles" />
        <TextBlock Text="{Binding Folder.EmptyMessage}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="A profile is a YAML file. Start a new one here, capture one from a repository, choose a folder that already has profiles, or keep them in a GitHub repository so they follow you to any computer." />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary" Content="New profile" Command="{Binding StartNewCommand}" CommandParameter="{x:Null}" />
          <Button Classes="quiet" Content="{Binding Folder.FolderLabel}" Command="{Binding ChangeFolderCommand}" />
          <Button Classes="quiet" Content="{Binding Folder.RepositoryLabel}" Command="{Binding StartConnectCommand}" />
          <Button Classes="quiet" Content="{Binding Folder.RefreshLabel}" Command="{Binding RefreshCommand}" />
        </StackPanel>
      </StackPanel>

      <!-- The folder has profiles and none is open, such as after one is closed -->
      <StackPanel x:Name="NoneOpen" Margin="32,24" Spacing="12" MaxWidth="560" HorizontalAlignment="Left" IsVisible="{Binding ShowNoneOpen}">
        <TextBlock Classes="h1" Text="Profiles" />
        <TextBlock TextWrapping="Wrap" Text="Choose a profile in the list to edit it, or start a new one." />
        <Button x:Name="NoneOpenNew" Classes="quiet" HorizontalAlignment="Left" Content="New profile"
                Command="{Binding StartNewCommand}" CommandParameter="{x:Null}" />
      </StackPanel>

      <ContentControl Content="{Binding Creating}" IsVisible="{Binding ShowCreating}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:NewProfileViewModel"><views:NewProfileView /></DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>

      <!-- The repository is chosen in the settings; the page says so while the form is open there -->
      <StackPanel Margin="32,24" Spacing="12" MaxWidth="560" HorizontalAlignment="Left" IsVisible="{Binding ShowConnecting}">
        <TextBlock Classes="h1" Text="Profiles" />
        <TextBlock TextWrapping="Wrap" Text="Choose the GitHub repository for your profiles in the settings." />
        <Button Classes="quiet" HorizontalAlignment="Left" Content="Show settings" Command="{Binding ShowSettingsCommand}" />
      </StackPanel>

      <ContentControl Content="{Binding Current}" IsVisible="{Binding ShowProfile}" IsEnabled="{Binding !DeleteRunning}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:ProfileViewModel"><views:ProfileView /></DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Panel>
  </DockPanel>
</UserControl>
