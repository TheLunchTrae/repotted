<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Repotted.Desktop.ViewModels"
             xmlns:views="using:Repotted.Desktop.Views"
             x:Class="Repotted.Desktop.Views.ProfilesView"
             x:DataType="vm:ProfilesViewModel">
  <DockPanel>
    <!-- The folder the profiles come from -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="32,10" IsVisible="{Binding !ShowEmpty}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Classes="muted small" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding Folder}">
          <Run Text="Profiles folder:" /> <Run Classes="mono" Text="{Binding Folder}" />
        </TextBlock>
        <Button Grid.Column="1" Classes="link" Margin="16,0,0,0" Content="Change folder"
                Command="{Binding ChangeFolderCommand}" />
        <Button Grid.Column="2" Classes="link" Margin="16,0,0,0" Content="Refresh"
                Command="{Binding RefreshCommand}" />
      </Grid>
    </Border>

    <Panel>
      <TextBlock Classes="muted" Margin="32,24" Text="Loading profiles" IsVisible="{Binding Loading}" />

      <StackPanel Margin="32,24" Spacing="12" IsVisible="{Binding HasError}">
        <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource RemoveBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="quiet" Content="Try again" Command="{Binding RefreshCommand}" />
          <Button Classes="quiet" Content="Change folder" Command="{Binding ChangeFolderCommand}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Margin="32,24" Spacing="12" MaxWidth="560" HorizontalAlignment="Left" IsVisible="{Binding ShowEmpty}">
        <TextBlock Classes="h1" Text="Profiles" />
        <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="A profile is a YAML file. Copy one into this folder, or choose a folder that already has profiles, such as a clone of your setup repository." />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary" Content="Choose a folder" Command="{Binding ChangeFolderCommand}" />
          <Button Classes="quiet" Content="Refresh" Command="{Binding RefreshCommand}" />
        </StackPanel>
      </StackPanel>

      <ContentControl Content="{Binding Current}" IsVisible="{Binding ShowProfile}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:ProfileViewModel"><views:ProfileView /></DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Panel>
  </DockPanel>
</UserControl>
