<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Repotted.Desktop.ViewModels"
             x:Class="Repotted.Desktop.Views.RepositoriesView"
             x:DataType="vm:RepositoriesViewModel">
  <UserControl.Resources>
    <!-- One section's bar, colored by its state. -->
    <DataTemplate x:Key="SectionBar" x:DataType="vm:SectionStatus">
      <Border Classes="bar unmanaged" ToolTip.Tip="{Binding Name}" />
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The owner filter shows when it hides some owners. -->
    <Style Selector="Button.owners.filtered /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TintBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RailBrush}" />
    </Style>
    <!-- An owner's heading is part of the table, not a row to select, so it keeps its colors though disabled. -->
    <Style Selector="ListBox.table ListBoxItem.owner /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Heading and actions -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="32,24,32,0">
      <StackPanel Spacing="6">
        <TextBlock Classes="h1" Text="Repositories" />
        <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Button Classes="quiet" Content="Add repositories" IsVisible="{Binding ShowAddInHeading}"
                Command="{Binding AddRepositoriesCommand}" />
        <Button Classes="primary" Content="Refresh" Command="{Binding RefreshCommand}" />
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="*,340" Margin="32,20,32,32">
      <!-- The list -->
      <DockPanel Margin="0,0,24,0">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,14">
          <TextBox x:Name="RepositorySearch" Classes="search" Margin="0,0,4,0" VerticalAlignment="Center"
                   PlaceholderText="Find a repository" Text="{Binding Filter}" IsVisible="{Binding ShowTable}"
                   AutomationProperties.Name="Find a repository">
            <TextBox.InnerRightContent>
              <Border Classes="kbd" Margin="6,0,0,0" IsHitTestVisible="False">
                <TextBlock x:Name="SearchShortcut" Classes="mono muted" FontSize="12" Text="Ctrl F" />
              </Border>
            </TextBox.InnerRightContent>
          </TextBox>
          <!-- Which owners' repositories the list shows -->
          <Button Classes="quiet owners" Classes.filtered="{Binding OwnersFiltered}" VerticalAlignment="Center"
                  IsVisible="{Binding ShowOwnerFilter}" AutomationProperties.Name="{Binding OwnersLabel, StringFormat='Owners: {0}'}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding OwnersLabel}" VerticalAlignment="Center" />
              <Path Data="M 1,1 L 5,5 L 9,1" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6"
                    StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Width="280">
                  <TextBlock Classes="muted small" FontWeight="SemiBold" Margin="2,0,0,8" Text="Show repositories owned by" />
                  <ItemsControl ItemsSource="{Binding Owners}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:OwnerChoice">
                        <CheckBox IsChecked="{Binding Shown}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  AutomationProperties.Name="{Binding Description}">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="{Binding Owner}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Classes="muted small" Margin="8,0,0,0" Text="Personal"
                                       VerticalAlignment="Center" IsVisible="{Binding Personal}" />
                            <TextBlock Grid.Column="2" Classes="muted small" Margin="8,0,0,0" Text="{Binding Count}"
                                       VerticalAlignment="Center" />
                          </Grid>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="rule" Margin="0,8" />
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Classes="link" Content="Only personal" IsVisible="{Binding HasPersonal}"
                            Command="{Binding ShowOnlyPersonalCommand}" />
                    <Button Grid.Column="2" Classes="link" Content="Show all" Command="{Binding ShowAllOwnersCommand}" />
                  </Grid>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Border Classes="chip" IsVisible="{Binding ShowTable}">
            <TextBlock Text="{Binding CountLabel}" />
          </Border>
          <!-- A batch apply that was left unfinished -->
          <Border Classes="chip" Padding="10,0" IsVisible="{Binding HasUnfinishedBatch}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="A batch apply is not finished." VerticalAlignment="Center" />
              <Button Classes="link" Content="Resume" Command="{Binding ResumeBatchCommand}" VerticalAlignment="Center"
                      AutomationProperties.Name="Resume the batch apply" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Panel>
          <TextBlock Classes="muted" Text="Loading repositories" IsVisible="{Binding Loading}" />

          <StackPanel Spacing="12" IsVisible="{Binding HasError}">
            <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource RemoveBrush}" />
            <Button Classes="quiet" Content="Try again" HorizontalAlignment="Left" Command="{Binding RefreshCommand}" />
          </StackPanel>

          <StackPanel Spacing="12" IsVisible="{Binding ShowEmpty}">
            <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" />
            <Button Classes="primary" Content="Add repositories" HorizontalAlignment="Left"
                    IsVisible="{Binding CanAddRepositories}" Command="{Binding AddRepositoriesCommand}" />
          </StackPanel>

          <DockPanel IsVisible="{Binding ShowTable}">
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="32,*,72,128,104,64" Margin="12,8">
                <Grid.Styles>
                  <Style Selector="TextBlock">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                  </Style>
                </Grid.Styles>
                <TextBlock Grid.Column="1" Text="Repository" />
                <TextBlock Grid.Column="2" Text="Profile" />
                <TextBlock Grid.Column="3" Text="Sections" />
                <TextBlock Grid.Column="4" Text="Status" />
                <TextBlock Grid.Column="5" Text="Checked" />
              </Grid>
            </Border>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="12,16"
                        IsVisible="{Binding EveryOwnerHidden}">
              <TextBlock Classes="muted" Text="The owner filter hides every repository." VerticalAlignment="Center" />
              <Button Classes="link" Content="Show all" Command="{Binding ShowAllOwnersCommand}" VerticalAlignment="Center" />
            </StackPanel>
            <!-- Each owner's heading, then its repositories. The view names each item for screen readers and
                 keeps the headings out of the selection. -->
            <ListBox x:Name="List" Classes="table" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                     SelectionMode="Multiple" AutomationProperties.Name="Repositories">
              <ListBox.DataTemplates>
                <DataTemplate x:DataType="vm:OwnerHeading">
                  <Grid ColumnDefinitions="Auto,Auto,*" Margin="12,16,12,6">
                    <TextBlock Text="{Binding Owner}" FontWeight="Bold" VerticalAlignment="Bottom" />
                    <TextBlock Grid.Column="1" Classes="muted small" Margin="10,0,0,0" Text="Personal"
                               VerticalAlignment="Bottom" IsVisible="{Binding Personal}" />
                    <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding Count}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                  </Grid>
                </DataTemplate>
                <DataTemplate x:DataType="vm:RepositoryRowViewModel">
                  <Panel>
                    <Border Classes="selection-rail" />
                    <Grid ColumnDefinitions="32,*,72,128,104,64" Margin="12,11">
                      <!-- Ticking several repositories, or Shift- or Ctrl-clicking them, chooses them for a batch apply -->
                      <CheckBox VerticalAlignment="Center" IsChecked="{Binding $parent[ListBoxItem].IsSelected}"
                                AutomationProperties.Name="{Binding FullName, StringFormat='Choose {0}'}" />
                      <!-- The owner's heading above names the owner. -->
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FullName}"
                                 Text="{Binding Name}" FontWeight="Bold" />
                      <TextBlock Grid.Column="2" Classes="muted" Text="None" VerticalAlignment="Center" />
                      <ItemsControl Grid.Column="3" ItemsSource="{Binding Sections}" VerticalAlignment="Center"
                                    ItemTemplate="{StaticResource SectionBar}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                      <Border Grid.Column="4" Classes="pill none">
                        <StackPanel Orientation="Horizontal"><Ellipse /><TextBlock Text="No profile" /></StackPanel>
                      </Border>
                      <TextBlock Grid.Column="5" Classes="muted" Text="Never" VerticalAlignment="Center" />
                    </Grid>
                  </Panel>
                </DataTemplate>
              </ListBox.DataTemplates>
            </ListBox>
          </DockPanel>
        </Panel>
      </DockPanel>

      <!-- The chosen repositories, for a batch apply -->
      <Border Grid.Column="1" Classes="panel" VerticalAlignment="Top" IsVisible="{Binding Choosing}">
        <StackPanel>
          <TextBlock Classes="h2" Text="{Binding ChosenLabel}" TextWrapping="Wrap" />
          <TextBlock Classes="muted small" Margin="0,4,0,14" TextWrapping="Wrap"
                     Text="Apply one profile to all of them, with each repository's changes to review on its own first." />
          <TextBlock Classes="muted small" FontWeight="SemiBold" Margin="0,0,0,6" Text="Profile to apply" />
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Choices}" SelectedItem="{Binding CompareWith}"
                    PlaceholderText="No profiles in the folder" AutomationProperties.Name="Profile to apply">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileItemViewModel">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="primary" HorizontalAlignment="Stretch" Margin="0,8,0,0" Content="Review apply"
                  Command="{Binding ReviewBatchCommand}" IsVisible="{Binding CanBatch}"
                  AutomationProperties.HelpText="Shows what the profile changes in each repository, to edit before anything is written." />
          <TextBlock Classes="muted small" Margin="0,12,0,0" TextWrapping="Wrap"
                     Text="A repository with an apply that isn't finished joins the batch as it is. Nothing is written until you confirm." />
        </StackPanel>
      </Border>

      <!-- The selected repository -->
      <Border Grid.Column="1" Classes="panel" VerticalAlignment="Top" IsVisible="{Binding HasSelection}">
        <StackPanel>
          <TextBlock Classes="h2" Text="{Binding Selected.FullName, FallbackValue=''}" TextWrapping="Wrap" />
          <TextBlock Classes="muted small" Margin="0,4,0,14" TextWrapping="Wrap">
            <Run Text="{Binding Selected.Visibility, FallbackValue=''}" />
            <Run Text="Follows no profile yet." />
          </TextBlock>
          <ItemsControl ItemsSource="{Binding Selected.Sections, FallbackValue={x:Null}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SectionStatus">
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <TextBlock Classes="muted" FontSize="14" Text="{Binding Name}" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="pill none">
                    <StackPanel Orientation="Horizontal"><Ellipse /><TextBlock Text="Not managed" /></StackPanel>
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="rule" />
          <TextBlock Classes="muted small" FontWeight="SemiBold" Margin="0,0,0,6" Text="Compare with a profile" />
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Choices}" SelectedItem="{Binding CompareWith}"
                    PlaceholderText="No profiles in the folder" AutomationProperties.Name="Profile to compare with">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileItemViewModel">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Grid ColumnDefinitions="*,8,*" Margin="0,8,0,0">
            <Button Classes="primary" HorizontalAlignment="Stretch" Content="Compare"
                    Command="{Binding CompareCommand}" />
            <Button Grid.Column="2" Classes="quiet" HorizontalAlignment="Stretch" Content="Apply"
                    Command="{Binding ApplyProfileCommand}" IsVisible="{Binding CanApply}"
                    AutomationProperties.HelpText="Shows what the profile changes, to edit before anything is written." />
          </Grid>
          <!-- An apply to this repository that was left unfinished -->
          <Border Classes="chip" HorizontalAlignment="Stretch" Margin="0,12,0,0" Padding="10,8"
                  IsVisible="{Binding HasUnfinishedApply}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="An apply here is not finished." TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="link" Margin="8,0,0,0" Content="Resume"
                      Command="{Binding ResumeApplyCommand}" />
            </Grid>
          </Border>
          <Border Classes="rule" />
          <Button Classes="quiet" HorizontalAlignment="Stretch" Content="Change settings once"
                  Command="{Binding ChangeSettingsCommand}" IsVisible="{Binding CanApply}"
                  AutomationProperties.HelpText="Starts from the repository as it is, without a profile." />
          <Button Classes="quiet" HorizontalAlignment="Stretch" Margin="0,8,0,0" Content="Capture as a profile"
                  Command="{Binding CaptureCommand}" />
          <Button Classes="quiet" HorizontalAlignment="Stretch" Margin="0,8,0,0" Content="Open on GitHub"
                  Command="{Binding OpenOnGitHubCommand}" />
          <TextBlock Classes="muted small" Margin="0,12,0,0" TextWrapping="Wrap"
                     Text="Comparing and capturing only read from GitHub. An apply shows its changes first, and writes nothing until you confirm." />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
