<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="using:Repotted.Desktop.Theme"
             xmlns:vm="using:Repotted.Desktop.ViewModels"
             x:Class="Repotted.Desktop.Views.NewProfileView"
             x:DataType="vm:NewProfileViewModel">
  <ScrollViewer>
    <StackPanel Margin="32,24" Spacing="20" MaxWidth="560" HorizontalAlignment="Left">
      <StackPanel Spacing="6">
        <TextBlock Classes="h1" Text="{theme:Label 'New profile'}" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="A profile manages only what it names. Once it is made, edit it here, or compare it with a repository to see what it would change." />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Classes="small" FontWeight="SemiBold" Text="Name" />
        <TextBox x:Name="NameBox" Text="{Binding Name}" IsEnabled="{Binding Editable}" AutomationProperties.Name="Profile name"
                 AutomationProperties.HelpText="{Binding Problem}" PlaceholderText="For example, libraries" />
        <TextBlock Classes="muted small" IsVisible="{Binding ShowFileName}">
          <Run Text="Saved as" /> <Run Classes="mono" Text="{Binding FileName}" /> <Run Text="in the profiles folder." />
        </TextBlock>
        <TextBlock Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource RemoveBrush}" Text="{Binding Problem}"
                   IsVisible="{Binding HasProblem}" AutomationProperties.LiveSetting="Assertive" />
      </StackPanel>

      <!-- Shown once the profiles folder has a subfolder to choose -->
      <StackPanel Spacing="6" IsVisible="{Binding HasPlaces}">
        <TextBlock Classes="small" FontWeight="SemiBold" Text="Folder" />
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Places}" SelectedItem="{Binding Place}"
                  IsEnabled="{Binding Editable}" AutomationProperties.Name="Folder">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NewProfilePlace">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <!-- What owns the repositories the profile is for; a capture or a typed base sets it instead -->
      <StackPanel Spacing="10" IsEnabled="{Binding Editable}">
        <TextBlock Classes="small" FontWeight="SemiBold" Text="For repositories owned by" />
        <StackPanel Spacing="10" IsVisible="{Binding !OwnerFixed}">
          <RadioButton GroupName="owner" IsChecked="{Binding OwnerPersonal}"
                       AutomationProperties.HelpText="Settings only organizations have stay hidden.">
            <StackPanel Spacing="2">
              <TextBlock Text="Personal accounts" />
              <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Settings only organizations have stay hidden." />
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="owner" IsChecked="{Binding OwnerOrganization}"
                       AutomationProperties.HelpText="Every setting. The ones only GitHub Enterprise Cloud has are marked.">
            <StackPanel Spacing="2">
              <TextBlock Text="Organizations" />
              <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Every setting. The ones only GitHub Enterprise Cloud has are marked." />
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="owner" IsChecked="{Binding OwnerAny}"
                       AutomationProperties.HelpText="For a base profile that both kinds extend. GitHub skips what a repository doesn't have.">
            <StackPanel Spacing="2">
              <TextBlock Text="Any owner" />
              <TextBlock Classes="muted small" TextWrapping="Wrap" Text="For a base profile that both kinds extend. GitHub skips what a repository doesn't have." />
            </StackPanel>
          </RadioButton>
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Repotted won't apply a profile to a repository whose owner is the other kind." />
        </StackPanel>
        <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding OwnerNote}" IsVisible="{Binding HasOwnerNote}" />
      </StackPanel>

      <StackPanel Spacing="10" IsEnabled="{Binding Editable}">
        <TextBlock Classes="small" FontWeight="SemiBold" Text="Start from" />
        <RadioButton GroupName="start" IsChecked="{Binding StartsEmpty}"
                     AutomationProperties.HelpText="An empty profile, which manages nothing until you set something.">
          <StackPanel Spacing="2">
            <TextBlock Text="Nothing" />
            <TextBlock Classes="muted small" TextWrapping="Wrap" Text="An empty profile, which manages nothing until you set something." />
          </StackPanel>
        </RadioButton>
        <RadioButton GroupName="start" IsChecked="{Binding Extends}" IsEnabled="{Binding HasBases}"
                     AutomationProperties.HelpText="{Binding ExtendsHelp}">
          <StackPanel Spacing="2">
            <TextBlock Text="Another profile" />
            <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding ExtendsHelp}" />
          </StackPanel>
        </RadioButton>
        <ComboBox Margin="28,0,0,0" HorizontalAlignment="Stretch" ItemsSource="{Binding Bases}" SelectedItem="{Binding Base}"
                  IsVisible="{Binding Extends}" AutomationProperties.Name="Profile to extend">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProfileItemViewModel">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <RadioButton GroupName="start" IsChecked="{Binding Captures}" IsEnabled="{Binding HasRepositories}"
                     AutomationProperties.HelpText="{Binding CaptureHelp}">
          <StackPanel Spacing="2">
            <TextBlock Text="A repository" />
            <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding CaptureHelp}" />
          </StackPanel>
        </RadioButton>
        <ComboBox Margin="28,0,0,0" HorizontalAlignment="Stretch" ItemsSource="{Binding Repositories}" SelectedItem="{Binding Repository}"
                  IsVisible="{Binding Captures}" AutomationProperties.Name="Repository to capture" />
      </StackPanel>

      <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource RemoveBrush}"
                           IsVisible="{Binding HasError}" AutomationProperties.LiveSetting="Assertive" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="primary" Content="{Binding CreateLabel}" Command="{Binding CreateCommand}" IsDefault="True" />
        <Button Classes="quiet" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
        <TextBlock Classes="muted small" VerticalAlignment="Center" Text="Capturing from GitHub" IsVisible="{Binding Working}"
                   AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
