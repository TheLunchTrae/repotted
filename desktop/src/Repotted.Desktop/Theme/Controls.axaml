<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="using:Repotted.Desktop.Theme">
  <!-- The custom theme over Fluent: the approved mock-ups' type, buttons,
       pills, chips, navigation and table rows. -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <!-- Text -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="13.5" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>

  <!-- Keyboard focus: a 2px ring, set 2px outside the control. -->
  <Style Selector="Button, ToggleButton, ListBoxItem">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" BorderBrush="{DynamicResource FocusBrush}" Margin="-4" CornerRadius="10" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.table ListBoxItem, ListBox.rows ListBoxItem">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" BorderBrush="{DynamicResource FocusBrush}" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <!-- A button's text is its label, in the platform's casing: ControlLabel
       gives text content an access-key label in title style on macOS and as
       written elsewhere. Put names and other data in a TextBlock inside the
       button instead, so they keep their own casing. -->

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource RailBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RailBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
  </Style>
  <Style Selector="Button.quiet">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <!-- After the hover styles, which a press would otherwise lose to. -->
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryPressedBrush}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <!-- A link: text in the link color that opens something. -->
  <Style Selector="Button.link">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="TextBlock.TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
  </Style>

  <!-- Status pills: a dot and a label on a tinted ground. -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="9,2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Border.pill Ellipse">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill.none">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
  </Style>
  <Style Selector="Border.pill.none TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Border.pill.none Ellipse">
    <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
  </Style>

  <Style Selector="Border.pill.ok">
    <Setter Property="Background" Value="{DynamicResource AddBgBrush}" />
  </Style>
  <Style Selector="Border.pill.ok TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AddBrush}" />
  </Style>
  <Style Selector="Border.pill.ok Ellipse">
    <Setter Property="Fill" Value="{DynamicResource AddBrush}" />
  </Style>
  <Style Selector="Border.pill.draft">
    <Setter Property="Background" Value="{DynamicResource DraftBgBrush}" />
  </Style>
  <Style Selector="Border.pill.draft TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DraftBrush}" />
  </Style>
  <Style Selector="Border.pill.draft Ellipse">
    <Setter Property="Fill" Value="{DynamicResource DraftBrush}" />
  </Style>
  <Style Selector="Border.pill.drift">
    <Setter Property="Background" Value="{DynamicResource DriftBgBrush}" />
  </Style>
  <Style Selector="Border.pill.drift TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DriftBrush}" />
  </Style>
  <Style Selector="Border.pill.drift Ellipse">
    <Setter Property="Fill" Value="{DynamicResource DriftBrush}" />
  </Style>

  <!-- A section's bar in the Sections column. -->
  <Style Selector="Border.bar">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Margin" Value="0,0,3,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.bar.unmanaged">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>

  <!-- Panels -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
    <Setter Property="Padding" Value="20,18" />
  </Style>
  <!-- A profile's draft: saved, and left out of compare and apply until Save. -->
  <Style Selector="Border.banner.draft">
    <Setter Property="Background" Value="{DynamicResource DraftBgBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
    <Setter Property="Padding" Value="16,10" />
  </Style>
  <Style Selector="TextBlock.draft">
    <Setter Property="Foreground" Value="{DynamicResource DraftBrush}" />
  </Style>
  <!-- The editor's footer, with its save actions. -->
  <Style Selector="Border.footer">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Margin" Value="0,16" />
  </Style>
  <Style Selector="Border.avatar">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{DynamicResource TintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.code">
    <Setter Property="Background" Value="{DynamicResource CodeBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="18,12" />
  </Style>

  <!-- Search -->
  <Style Selector="TextBox.search">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Width" Value="320" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RailBrush}" />
  </Style>
  <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox.search /template/ TextBlock#PART_Placeholder, TextBox.search /template/ TextBlock#PART_FloatingPlaceholder">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Border.kbd">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Filter chip -->
  <Style Selector="Border.chip">
    <Setter Property="BorderBrush" Value="{DynamicResource RailBrush}" />
    <Setter Property="Background" Value="{DynamicResource AddBgBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,2" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AddBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Filter toggle: outlined while off, and solid while on, as a chosen segment is. -->
  <Style Selector="ToggleButton.chip">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.chip /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RailBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BgBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Sidebar navigation -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RailBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- The profiles tree in the sidebar: rows like the navigation above it -->
  <Style Selector="TreeView.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TreeView.nav TreeViewItem">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="Padding" Value="4,6,10,6" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
  </Style>
  <Style Selector="TreeView.nav TreeViewItem /template/ Border#PART_LayoutRoot">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TreeView.nav TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
  </Style>
  <Style Selector="TreeView.nav TreeViewItem:selected /template/ Border#PART_LayoutRoot, TreeView.nav TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot, TreeView.nav TreeViewItem:selected:focus /template/ Border#PART_LayoutRoot, TreeView.nav TreeViewItem:selected:pressed /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource TintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RailBrush}" />
  </Style>
  <Style Selector="TreeView.nav TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- The mark beside the folder or repository the profiles are in -->
  <Style Selector="Border.source">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.source Path">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Icons for a folder, a profile file and a GitHub repository, drawn in 16 by 16 -->
  <Style Selector="Path.folder, Path.profile, Path.repo">
    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.4" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="None" />
  </Style>
  <Style Selector="Path.folder">
    <Setter Property="Data" Value="M1.8,4.2 A1,1 0 0 1 2.8,3.2 H5.8 L7.2,4.7 H13.2 A1,1 0 0 1 14.2,5.7 V12.5 A1,1 0 0 1 13.2,13.5 H2.8 A1,1 0 0 1 1.8,12.5 Z" />
  </Style>
  <Style Selector="Path.profile">
    <Setter Property="Data" Value="M4,1.8 H9.2 L12.5,5.1 V13.6 A0.7,0.7 0 0 1 11.8,14.3 H4 A0.7,0.7 0 0 1 3.3,13.6 V2.5 A0.7,0.7 0 0 1 4,1.8 Z M9,1.9 V5.2 H12.4" />
  </Style>
  <Style Selector="Path.repo">
    <Setter Property="Data" Value="M3,2.8 A1.3,1.3 0 0 1 4.3,1.5 H13 V11.7 H4.3 A1.3,1.3 0 0 0 3,13 Z M3,13 A1.3,1.3 0 0 0 4.3,14.3 H13 V11.7 M5.6,4.4 H10.2" />
  </Style>

  <!-- Radio buttons in the theme's green, not the system accent -->
  <Style Selector="RadioButton:checked /template/ Ellipse#CheckOuterEllipse, RadioButton:checked:pointerover /template/ Ellipse#CheckOuterEllipse, RadioButton:checked:pressed /template/ Ellipse#CheckOuterEllipse">
    <Setter Property="Fill" Value="{DynamicResource RailBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource RailBrush}" />
  </Style>
  <Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph, RadioButton:checked:pointerover /template/ Ellipse#CheckGlyph, RadioButton:checked:pressed /template/ Ellipse#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource SurfaceBrush}" />
  </Style>

  <!-- Compare rows: a list so each row is read out, which looks like the table around it -->
  <Style Selector="ListBox.rows">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.rows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Table rows -->
  <Style Selector="ListBox.table">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="FontSize" Value="14.5" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TintBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem Border.selection-rail">
    <Setter Property="Width" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:selected Border.selection-rail">
    <Setter Property="Background" Value="{DynamicResource RailBrush}" />
  </Style>
  <!-- Tabs over a profile's sections, with a count of what each manages. -->
  <Style Selector="ListBox.tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="Padding" Value="12,8,12,10" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource FgBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.count">
    <Setter Property="Background" Value="{DynamicResource TintBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.count TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <!-- The steps of an apply's review: the one on screen, and one already passed. -->
  <Style Selector="StackPanel.step">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.step Border.stepnum">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.step Border.stepnum TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="StackPanel.step TextBlock.steplabel">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="StackPanel.step.on Border.stepnum">
    <Setter Property="Background" Value="{DynamicResource FgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="StackPanel.step.on Border.stepnum TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BgBrush}" />
  </Style>
  <!-- The current step keeps the same weight, so its label never measures differently. -->
  <Style Selector="StackPanel.step.on TextBlock.steplabel">
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="StackPanel.step.done Border.stepnum">
    <Setter Property="Background" Value="{DynamicResource TintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RailBrush}" />
  </Style>
  <Style Selector="StackPanel.step.done Border.stepnum TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource RailBrush}" />
  </Style>

  <!-- Setting rows: a rail that says where the value comes from. -->
  <Style Selector="Border.fields">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.field">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="MinHeight" Value="60" />
  </Style>
  <Style Selector="Border.rail">
    <Setter Property="Width" Value="4" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.rail.own">
    <Setter Property="Background" Value="{DynamicResource RailBrush}" />
  </Style>
  <Style Selector="Border.rail.inherited">
    <Setter Property="Background" Value="{DynamicResource RailInheritedBrush}" />
  </Style>
  <Style Selector="Border.rail.draft">
    <Setter Property="Background" Value="{DynamicResource DraftRailBrush}" />
  </Style>
  <Style Selector="Border.rail.changed">
    <Setter Property="Background" Value="{DynamicResource DriftRailBrush}" />
  </Style>
  <Style Selector="StackPanel.setting">
    <Setter Property="Margin" Value="16,10" />
  </Style>
  <!-- A sub-option, indented under the setting it belongs to. -->
  <Style Selector="StackPanel.setting.nested">
    <Setter Property="Margin" Value="40,10,16,10" />
  </Style>
  <Style Selector="Border.field.nested">
    <Setter Property="MinHeight" Value="52" />
  </Style>
  <!-- Choices that go under the setting's label line up with it. -->
  <Style Selector="Border.seg.wide">
    <Setter Property="Margin" Value="16,0,16,12" />
  </Style>
  <Style Selector="Border.seg.wide.nested">
    <Setter Property="Margin" Value="40,0,16,12" />
  </Style>
  <Style Selector="TextBox.setting">
    <Setter Property="Width" Value="220" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <!-- A list goes under the label, like long choices. -->
  <Style Selector="StackPanel.typed.wide">
    <Setter Property="Margin" Value="16,0,16,12" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="StackPanel.typed.wide.nested">
    <Setter Property="Margin" Value="40,0,16,12" />
  </Style>
  <Style Selector="TextBox.setting.list">
    <Setter Property="Width" Value="420" />
    <Setter Property="MinHeight" Value="88" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <!--
    A list of allowed action patterns, with what each line matches beside it.
    The list's lines and the checks are the same height, and the list keeps
    its border's width with focus, so a check stays beside its line.
  -->
  <Style Selector="ContentControl.patterns">
    <Setter Property="Margin" Value="40,0,16,12" />
  </Style>
  <Style Selector="ContentControl.patterns TextBox.setting.list">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="LineHeight" Value="26" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="ContentControl.patterns TextBox.setting.list:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ItemsControl.checks">
    <Setter Property="Margin" Value="0,7,0,0" />
  </Style>
  <Style Selector="Border.check">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="14,0,0,0" />
  </Style>
  <Style Selector="TextBlock.check">
    <Setter Property="FontSize" Value="13.5" />
  </Style>
  <Style Selector="TextBlock.check.warning">
    <Setter Property="Foreground" Value="{DynamicResource DriftBrush}" />
  </Style>
  <Style Selector="TextBlock.check.bad">
    <Setter Property="Foreground" Value="{DynamicResource RemoveBrush}" />
  </Style>
  <Style Selector="TextBlock.check.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <!-- A check's mark: a tick, an exclamation mark, a cross or a dash on a disc, or a ring that turns while GitHub is asked. -->
  <Style Selector="Panel.mark">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Panel.mark Path">
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Panel.mark.good Ellipse">
    <Setter Property="Fill" Value="{DynamicResource AddBgBrush}" />
  </Style>
  <Style Selector="Panel.mark.good Path">
    <Setter Property="Data" Value="M4.6,8.3 L7,10.6 L11.4,5.7" />
    <Setter Property="Stroke" Value="{DynamicResource AddBrush}" />
  </Style>
  <Style Selector="Panel.mark.warning Ellipse">
    <Setter Property="Fill" Value="{DynamicResource DriftBgBrush}" />
  </Style>
  <Style Selector="Panel.mark.warning Path">
    <Setter Property="Data" Value="M8,4.4 V8.8 M8,11.4 V11.5" />
    <Setter Property="Stroke" Value="{DynamicResource DriftBrush}" />
  </Style>
  <Style Selector="Panel.mark.bad Ellipse">
    <Setter Property="Fill" Value="{DynamicResource RemoveBgBrush}" />
  </Style>
  <Style Selector="Panel.mark.bad Path">
    <Setter Property="Data" Value="M5.4,5.4 L10.6,10.6 M10.6,5.4 L5.4,10.6" />
    <Setter Property="Stroke" Value="{DynamicResource RemoveBrush}" />
  </Style>
  <Style Selector="Panel.mark.muted Ellipse">
    <Setter Property="Fill" Value="{DynamicResource SunkenBrush}" />
  </Style>
  <Style Selector="Panel.mark.muted Path">
    <Setter Property="Data" Value="M5.4,8 H10.6" />
    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Panel.mark.checking Ellipse, Panel.mark.checking Path">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Panel.mark Arc">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="StartAngle" Value="0" />
    <Setter Property="SweepAngle" Value="270" />
    <Setter Property="Stroke" Value="{DynamicResource RailBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
  </Style>
  <Style Selector="Panel.mark Arc.spinner">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- A pattern that blocks what it names. -->
  <Style Selector="Border.blocks">
    <Setter Property="BorderBrush" Value="{DynamicResource RemoveBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.blocks TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource RemoveBrush}" />
  </Style>
  <!-- The search for actions, as wide as the list above it, and what it found. -->
  <Style Selector="TextBox.search.actions">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Height" Value="32" />
  </Style>
  <Style Selector="Path.magnifier">
    <Setter Property="Data" Value="M10.2,10.2 L13.5,13.5 M11.5,6.75 A4.75,4.75 0 1 1 2,6.75 A4.75,4.75 0 1 1 11.5,6.75 Z" />
    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Stretch" Value="None" />
  </Style>
  <Style Selector="Border.found">
    <Setter Property="Width" Value="560" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BoxShadow" Value="0 10 30 0 #29000000" />
    <Setter Property="Margin" Value="0,0,24,24" />
  </Style>
  <Style Selector="ListBox.found">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MaxHeight" Value="420" />
  </Style>
  <Style Selector="ListBox.found ListBoxItem">
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="ListBox.found ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.found ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TintBrush}" />
  </Style>
  <Style Selector="Button.add">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="FontSize" Value="13.5" />
  </Style>
  <Style Selector="TextBlock.actionfile.has">
    <Setter Property="Foreground" Value="{DynamicResource AddBrush}" />
  </Style>
  <Style Selector="Path.star">
    <Setter Property="Data" Value="M6,0.8 L7.5,4.2 L11.2,4.5 L8.4,7 L9.3,10.6 L6,8.7 L2.7,10.6 L3.6,7 L0.8,4.5 L4.5,4.2 Z" />
    <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Stretch" Value="None" />
  </Style>
  <Style Selector="Path.tick">
    <Setter Property="Data" Value="M2,6.4 L4.8,9 L10,3.2" />
    <Setter Property="Stroke" Value="{DynamicResource AddBrush}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Stretch" Value="None" />
  </Style>
  <Style Selector="Border.foot">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
    <Setter Property="Padding" Value="14,8" />
  </Style>
  <!-- A setting that another one turns off, which GitHub greys out: its name dims, and what says why stays readable. -->
  <Style Selector="Border.field.off TextBlock.dims">
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="TextBox.setting.number">
    <Setter Property="Width" Value="96" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="TextBlock.problem">
    <Setter Property="Foreground" Value="{DynamicResource RemoveBrush}" />
  </Style>

  <!-- An entry row that opens its editor. -->
  <Style Selector="Button.entry">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.entry /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.entry:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
  </Style>

  <!-- A value the profile leaves to GitHub, shown as GitHub's default. -->
  <Style Selector="CheckBox.dim, NumericUpDown.dim">
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Compare rows: tinted by what the profile does to the value. -->
  <Style Selector="Border.field.change">
    <Setter Property="Background" Value="{DynamicResource DriftBgBrush}" />
  </Style>
  <Style Selector="Border.field.add">
    <Setter Property="Background" Value="{DynamicResource AddBgBrush}" />
  </Style>
  <Style Selector="Border.field.remove">
    <Setter Property="Background" Value="{DynamicResource RemoveBgBrush}" />
  </Style>
  <Style Selector="Border.rail.change">
    <Setter Property="Background" Value="{DynamicResource DriftRailBrush}" />
  </Style>
  <Style Selector="Border.rail.add">
    <Setter Property="Background" Value="{DynamicResource RailBrush}" />
  </Style>
  <Style Selector="Border.rail.remove">
    <Setter Property="Background" Value="{DynamicResource RemoveBrush}" />
  </Style>
  <Style Selector="Border.rail.match">
    <Setter Property="Background" Value="{DynamicResource RailInheritedBrush}" />
  </Style>
  <!-- A label as GitHub shows it: its name on its own color. -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MaxWidth" Value="320" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Border.chip.plain">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
  </Style>
  <Style Selector="Border.chip.plain TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="Border.chip TextBlock.struck">
    <Setter Property="TextDecorations" Value="Strikethrough" />
  </Style>

  <!-- A color to pick for a label, and the label's color beside its box. -->
  <Style Selector="Button.swatch">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.swatch > Border">
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}" />
  </Style>
  <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Button.swatch.chosen /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="Border.swatch">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
  </Style>

  <Style Selector="TextBlock.gone">
    <Setter Property="Foreground" Value="{DynamicResource RemoveBrush}" />
    <Setter Property="TextDecorations" Value="Strikethrough" />
  </Style>
  <Style Selector="TextBlock.wanted">
    <Setter Property="Foreground" Value="{DynamicResource AddBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.wanted.removed">
    <Setter Property="Foreground" Value="{DynamicResource RemoveBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="TextBlock.wanted.same">
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="Border.legend">
    <Setter Property="Width" Value="4" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A padlock beside what Repotted can't change, drawn in the text's muted color. -->
  <Style Selector="Path.lock">
    <Setter Property="Data" Value="M4,6.5 V4.5 A3,3 0 0 1 10,4.5 V6.5 M2.5,6.5 H11.5 V13 H2.5 Z" />
    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.4" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Stretch" Value="None" />
  </Style>
  <Style Selector="Border.locks">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
  </Style>

  <!-- Segmented choice: the chosen option is solid. -->
  <Style Selector="Border.seg">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.seg">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="ToggleButton.seg /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="ToggleButton.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="ToggleButton.seg.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BgBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ToggleButton.seg.on.dim /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <!-- A profile's YAML -->
  <Style Selector="SelectableTextBlock.yaml">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>

  <!-- A plan as a diff of profile YAML: GitHub loses red lines and gets green ones. -->
  <!-- A sheet over the page, such as Preview, on a scrim that dims what is under it. -->
  <Style Selector="Border.scrim">
    <Setter Property="Background" Value="#66000000" />
  </Style>
  <Style Selector="Border.sheet">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="24,22" />
    <Setter Property="BoxShadow" Value="0 12 40 0 #40000000" />
  </Style>
  <Style Selector="Border.diff">
    <Setter Property="Background" Value="{DynamicResource CodeBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Padding" Value="0,6" />
  </Style>
  <Style Selector="Border.diffline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.diffline.added">
    <Setter Property="Background" Value="{DynamicResource AddBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AddBrush}" />
  </Style>
  <Style Selector="Border.diffline.removed">
    <Setter Property="Background" Value="{DynamicResource RemoveBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RemoveBrush}" />
  </Style>
  <Style Selector="Border.diffline TextBlock.sign, Border.diffline TextBlock.line">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.diffline TextBlock.sign">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Border.diffline TextBlock.line">
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>
  <Style Selector="Border.diffline TextBlock.line.indent">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="Border.diffline.added TextBlock.sign">
    <Setter Property="Foreground" Value="{DynamicResource AddBrush}" />
  </Style>
  <Style Selector="Border.diffline.removed TextBlock.sign">
    <Setter Property="Foreground" Value="{DynamicResource RemoveBrush}" />
  </Style>
  <Style Selector="Border.diffline TextBlock.line.removed">
    <Setter Property="TextDecorations" Value="Strikethrough" />
  </Style>
  <Style Selector="Border.difffold">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
    <Setter Property="Padding" Value="0,2" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <!-- Line icons, drawn in the text's color on a 16px grid. -->
  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.icon.gear">
    <Setter Property="Data" Value="M8,5 A2.7,2.7 0 1 0 8,10.4 A2.7,2.7 0 1 0 8,5 Z M6.9,2 H9.1 L9.5,3.7 L10.8,4.4 L12.4,3.8 L13.5,5.8 L12.2,7 V8.4 L13.5,9.6 L12.4,11.6 L10.8,11 L9.5,11.7 L9.1,13.4 H6.9 L6.5,11.7 L5.2,11 L3.6,11.6 L2.5,9.6 L3.8,8.4 V7 L2.5,5.8 L3.6,3.8 L5.2,4.4 L6.5,3.7 Z" />
  </Style>
  <Style Selector="Path.icon.sync">
    <Setter Property="Data" Value="M13,6.5 A5.2,5.2 0 0 0 3.4,5 M3,9.5 A5.2,5.2 0 0 0 12.6,11 M3.2,2.4 V5.2 H6 M12.8,13.6 V10.8 H10" />
  </Style>
  <Style Selector="Path.icon.chevron">
    <Setter Property="Data" Value="M4.5,6.5 L8,10 L11.5,6.5" />
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="-2,0,0,0" />
  </Style>
  <Style Selector="Path.icon.person">
    <Setter Property="Data" Value="M11,5.7 A3,3 0 1 0 5,5.7 A3,3 0 1 0 11,5.7 Z M2.5,14 C3.1,11.2 5.3,9.7 8,9.7 C10.7,9.7 12.9,11.2 13.5,14" />
    <Setter Property="Width" Value="16" />
  </Style>
  <Style Selector="Path.icon.folder">
    <Setter Property="Data" Value="M1.8,3.8 A1,1 0 0 1 2.8,2.8 H6 L7.4,4.4 H13.2 A1,1 0 0 1 14.2,5.4 V12.2 A1,1 0 0 1 13.2,13.2 H2.8 A1,1 0 0 1 1.8,12.2 Z" />
  </Style>

  <!-- The account at the top right, which opens its menu. -->
  <Style Selector="Button.account">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="4,0,10,0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <Style Selector="Button.account:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="Button.account Border.avatar">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="FlyoutPresenter.menu">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="MinWidth" Value="260" />
  </Style>
  <!-- An item in a menu: the whole row is the button. -->
  <Style Selector="Button.menuitem">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.menuitem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TintBrush}" />
  </Style>
  <!-- A small button with only an icon, which its tooltip and name describe. -->
  <Style Selector="Button.iconbutton">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.iconbutton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
  </Style>
  <Style Selector="Button.iconbutton:pointerover Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="TextBox.search.side">
    <Setter Property="Width" Value="NaN" />
  </Style>

  <!-- Settings: groups of rows, each a setting and the button that changes it. -->
  <Style Selector="Border.settings">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
  </Style>
  <Style Selector="Border.settingrow">
    <Setter Property="Padding" Value="18,14" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.settingrow.first">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.avatar.large">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <!-- A settings window's toolbar tabs: an icon over each pane's name. -->
  <Style Selector="ListBox.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.toolbar ListBoxItem">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinWidth" Value="76" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.toolbar ListBoxItem Path.icon">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.4" />
  </Style>
  <Style Selector="ListBox.toolbar ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
  </Style>
  <Style Selector="ListBox.toolbar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TintBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="ListBox.toolbar ListBoxItem:selected Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource RailBrush}" />
  </Style>
</Styles>
