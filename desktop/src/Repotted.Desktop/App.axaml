<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Repotted.Desktop.ViewModels"
             xmlns:views="using:Repotted.Desktop.Views"
             x:Class="Repotted.Desktop.App"
             Name="Repotted"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Repotted/Theme/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:LoadingViewModel"><views:LoadingView /></DataTemplate>
    <DataTemplate DataType="vm:ProblemViewModel"><views:ProblemView /></DataTemplate>
    <DataTemplate DataType="vm:SignInViewModel"><views:SignInView /></DataTemplate>
    <DataTemplate DataType="vm:ShellViewModel"><views:ShellView /></DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Repotted/Theme/Controls.axaml" />
  </Application.Styles>
</Application>
