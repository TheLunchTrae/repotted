{
  // The layout test and its config run under Node and drive the page. They
  // keep the root config's Node types and add the DOM library, as Playwright's
  // types need both. harness.tsx runs in the page and is checked with the web app.
  "extends": "../../../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "tsBuildInfoFile": ".tsbuildinfo"
  },
  "include": ["*.ts"],
  "exclude": []
}
