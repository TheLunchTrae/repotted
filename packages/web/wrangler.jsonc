{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repotted",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "node build.ts",
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // The Repotted App's client ID and secret are set in the dashboard. keep_vars
  // keeps a plain-text ID on production; Previews keep only secrets, so there
  // both are secrets.
  "keep_vars": true,
  // The custom domains are attached once in the dashboard, repotted.dev for
  // production and preview.repotted.dev for Previews, so deploys need no zone
  // permission and leave them alone. The workers.dev address and its Version
  // URLs stay off; Wrangler leaves preview_urls as it was when it's unset.
  "workers_dev": false,
  "preview_urls": false,
}
