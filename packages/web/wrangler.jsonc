{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repotted",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "node build.ts",
  },
  // Only /api/* reaches the Worker; every other path is a static file, and a
  // path with no file gets index.html, for the web app's own routes.
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // The Repotted App's client ID is public, as in packages/cli/src/auth.ts.
  // Its client secret is set once on the Worker, and every upload keeps it.
  "vars": {
    "REPOTTED_APP_CLIENT_ID": "Iv23liAnsCkUv2UeQoiK",
  },
  // Deploy Web's preview is one named Preview, main. Previews take none of the
  // production vars, so the client ID is set again here; the client secret is
  // set once for Previews in the dashboard.
  "previews": {
    "vars": {
      "REPOTTED_APP_CLIENT_ID": "Iv23liAnsCkUv2UeQoiK",
    },
  },
  // The custom domains are attached once in the dashboard, repotted.dev for
  // production and preview.repotted.dev for Previews, so deploys need no zone
  // permission and leave them alone. The workers.dev address and its Version
  // URLs stay off; Wrangler leaves preview_urls as it was when it's unset.
  "workers_dev": false,
  "preview_urls": false,
}
