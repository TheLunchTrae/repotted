{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repotted",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "node build.ts",
  },
  // Only /api/* reaches the Worker; every other path is a static file, and a
  // path with no file gets index.html, for the web app's own routes.
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // repotted.dev is attached to the Worker once in the dashboard, so deploys
  // need no zone permission and leave it alone. The sign-in works only at the
  // callback URLs the GitHub App lists, so the workers.dev and preview URLs
  // stay off.
  "workers_dev": false,
  "preview_urls": false,
}
