{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repotted",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "node build.ts",
  },
  // Only /api/* reaches the Worker; every other path is a static file, and a
  // path with no file gets index.html, for the web app's own routes.
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // The Repotted App's client ID is public, as in packages/cli/src/auth.ts.
  // Its client secret is set once on the Worker, and every upload keeps it.
  "vars": {
    "REPOTTED_APP_CLIENT_ID": "Iv23liAnsCkUv2UeQoiK",
  },
  // The custom domain is attached once in the dashboard, so deploys need no
  // zone permission and leave it alone. The workers.dev address stays off.
  // Preview URLs are on for Deploy Web's previews, which upload a version under
  // the preview alias without deploying it; every version also gets a URL of
  // its own.
  "workers_dev": false,
  "preview_urls": true,
}
