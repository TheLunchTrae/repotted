{
  // The Worker and the page run on web platform APIs, not Node's, so they get
  // the DOM library in place of Node's types. build.ts runs under Node and is
  // checked by the root config.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    // The engine's Node modules, as aliases.ts maps them for the bundle, so the
    // engine is checked here against the files and paths the page gives it.
    "paths": {
      "node:fs": ["./src/engine/files.ts"],
      "node:fs/promises": ["./src/engine/files.ts"],
      "node:path": ["./src/engine/path.ts"]
    },
    "tsBuildInfoFile": ".tsbuildinfo"
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": []
}
