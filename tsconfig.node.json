{
  // Shipped source runs under Node through npx, so it type-checks against
  // Node's types alone: no Bun global, bun: modules or import.meta.dir.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".node.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["packages/*/src/**/*", "types/**/*.d.ts"]
}
